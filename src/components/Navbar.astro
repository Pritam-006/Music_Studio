---
const navItems = [
  {
    label: "About",
    href: "/about",
  },
  {
    label: "Services",
    href: "/services",
  },
  {
    label: "Gallery",
    href: "/gallery",
  },
  {
    label: "Contact",
    href: "/contact",
  },
];
---

<header
  class="navbar relative z-50 border-b border-white/[0.08] bg-[#0a0a0f]/88 backdrop-blur-xl"
>
  <div
    class="mx-auto flex h-[72px] max-w-7xl items-center justify-between px-5 sm:px-8 lg:px-10"
  >
    <!-- ========================================================= -->
    <!-- LOGO -->
    <!-- ========================================================= -->

    <a
      href="/"
      class="group relative shrink-0"
      aria-label="Doremi Fusion home"
    >
      <img
        src="/images/branding/dlogo.png"
        alt="Doremi Fusion Music Studio"
        class="h-auto w-28 object-contain transition-all duration-300 ease-out group-hover:scale-[1.02] group-hover:opacity-95 sm:w-32"
      />
    </a>


    <!-- ========================================================= -->
    <!-- DESKTOP NAVIGATION -->
    <!-- ========================================================= -->

    <nav
      class="hidden items-center gap-10 md:flex"
      aria-label="Main navigation"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="group relative py-2 text-sm font-medium uppercase tracking-[0.14em] text-white/65 transition-colors duration-300 hover:text-white"
          >
            {item.label}

            <!-- Hover line -->
            <span
              class="absolute bottom-0 left-0 h-px w-0 bg-gradient-to-r from-[#a855f7] to-[#d946ef] transition-all duration-300 ease-out group-hover:w-full"
            ></span>
          </a>
        ))
      }
    </nav>


    <!-- ========================================================= -->
    <!-- MOBILE MENU BUTTON -->
    <!-- ========================================================= -->

    <button
      type="button"
      id="mobile-menu-button"
      class="group flex h-10 w-10 items-center justify-center text-white/75 transition-all duration-300 hover:text-white md:hidden"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <!-- Menu icon -->
      <svg
        id="menu-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16" />
        <path d="M4 12h16" />
        <path d="M4 17h16" />
      </svg>

      <!-- Close icon -->
      <svg
        id="close-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        class="hidden"
        aria-hidden="true"
      >
        <path d="M6 6l12 12" />
        <path d="M18 6L6 18" />
      </svg>
    </button>
  </div>


  <!-- ========================================================= -->
  <!-- MOBILE NAVIGATION -->
  <!-- ========================================================= -->

  <div
    id="mobile-menu"
    class="absolute left-0 right-0 top-full hidden overflow-hidden border-t border-white/[0.08] bg-[#0a0a0f]/[0.98] backdrop-blur-2xl md:hidden"
  >
    <nav
      class="mx-auto max-w-7xl px-5 py-7 sm:px-8"
      aria-label="Mobile navigation"
    >
      {
        navItems.map((item, index) => (
          <a
            href={item.href}
            class="mobile-nav-link group flex items-center justify-between border-b border-white/[0.08] py-5 text-base font-medium uppercase tracking-[0.14em] text-white/70 transition-colors duration-300 hover:text-white"
            style={`transition-delay: ${index * 50}ms`}
          >
            <span>{item.label}</span>

            <span
              class="text-sm text-[#d8b4fe] opacity-0 transition-all duration-300 group-hover:translate-x-1 group-hover:opacity-100"
            >
              →
            </span>
          </a>
        ))
      }

      <!-- Mobile footer text -->
      <div class="mt-9 flex items-center gap-3">
        <span class="h-px w-7 bg-[#a855f7]/60"></span>

        <p
          class="text-[10px] font-medium uppercase tracking-[0.24em] text-white/45"
        >
          Music Studio · Kolkata
        </p>
      </div>
    </nav>
  </div>
</header>


<script>
  const menuButton = document.querySelector(
    "#mobile-menu-button",
  ) as HTMLButtonElement | null;

  const mobileMenu = document.querySelector(
    "#mobile-menu",
  ) as HTMLElement | null;

  const menuIcon = document.querySelector(
    "#menu-icon",
  ) as SVGElement | null;

  const closeIcon = document.querySelector(
    "#close-icon",
  ) as SVGElement | null;

  const mobileLinks = document.querySelectorAll(
    ".mobile-nav-link",
  );

  if (menuButton && mobileMenu && menuIcon && closeIcon) {
    const setMenuState = (open: boolean) => {
      mobileMenu.classList.toggle("hidden", !open);

      menuIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);

      menuButton.setAttribute(
        "aria-expanded",
        String(open),
      );

      menuButton.setAttribute(
        "aria-label",
        open
          ? "Close navigation menu"
          : "Open navigation menu",
      );
    };

    menuButton.addEventListener("click", () => {
      const isOpen =
        menuButton.getAttribute("aria-expanded") === "true";

      setMenuState(!isOpen);
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        setMenuState(false);
      });
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768) {
        setMenuState(false);
      }
    });
  }
</script>