<section
  class="relative flex min-h-[calc(100svh-72px)] items-center overflow-hidden bg-[#030304]"
>
  <!-- Background image -->
  <div class="absolute inset-0">
    <img
      src="/images/studio/p1.JPG"
      alt="Doremi Fusion music studio in Kolkata"
      class="h-full w-full object-cover object-[60%_center] sm:object-center"
    />
  </div>

  <!-- Dark overlays -->
  <div class="absolute inset-0 bg-black/65"></div>

  <div
    class="absolute inset-0 bg-gradient-to-r from-black via-black/70 to-black/25"
  ></div>

  <div
    class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-[#030304] to-transparent"
  ></div>

  <!-- Hero content -->
  <div
    class="relative mx-auto w-full max-w-7xl px-5 py-16 sm:px-8 sm:py-24 lg:px-10"
  >
    <div class="max-w-4xl">

      <!-- Eyebrow -->
      <p
        class="mb-8 text-xs font-medium uppercase tracking-[0.38em] text-[#c084fc] sm:text-sm"
      >
        Music Studio · Kolkata
      </p>

      <!-- Heading -->
      <h1
        class="text-5xl font-semibold leading-[0.92] tracking-[-0.045em] text-white sm:text-6xl lg:text-[6.1rem]"
      >
        Music is more

        <span class="block text-white/45">
          than sound<span class="text-[#d946ef]">.</span>
        </span>
      </h1>

      <!-- Description -->
      <p
        class="mt-7 max-w-[21rem] text-base leading-7 text-white/60 sm:mt-8 sm:max-w-xl sm:text-lg sm:leading-8"
      >
        Recording, music production, mixing, mastering and musical
        experiences crafted at <span class="text-white">Doremi Fusion.</span>
      </p>

      <!-- Actions -->
      <div
        class="mt-9 flex flex-col items-start gap-3 sm:mt-10 sm:flex-row sm:gap-4"
      >
        <a
          href="/#services"
          class="group inline-flex items-center gap-3 rounded-full border border-[#a855f7] px-6 py-3.5 text-sm font-medium uppercase tracking-[0.12em] text-white transition-all duration-300 hover:bg-[#a855f7]/10 hover:shadow-[0_0_30px_rgba(168,85,247,0.18)]"
        >
          Explore the studio

          <span
            class="text-[#d946ef] transition-transform duration-300 group-hover:translate-x-1"
          >
            →
          </span>
        </a>

        <a
          href="/#contact"
          class="inline-flex items-center rounded-full border border-white/15 px-6 py-3.5 text-sm font-medium uppercase tracking-[0.12em] text-white/90 transition-all duration-300 hover:border-white/30 hover:bg-white/5"
        >
          Get in touch
        </a>
      </div>
    </div>

    <!-- Bottom metadata -->
    <div
      class="mt-14 flex items-center justify-between border-t border-white/[0.08] pt-5 sm:mt-24"
    >
      <span
        class="border-l border-[#c084fc] pl-4 text-[10px] uppercase tracking-[0.28em] text-white/40 sm:text-xs"
      >
        Where Musical Dreams Become Reality
      </span>

      <span
        class="hidden text-[10px] uppercase tracking-[0.28em] text-white/35 sm:block"
      >
        Kolkata, India
      </span>
    </div>
  </div>
</section>