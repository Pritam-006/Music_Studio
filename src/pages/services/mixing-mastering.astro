---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const serviceTypes = [
  {
    number: "01",
    title: "Mixing",
    description:
      "Bring vocals, instruments and production elements together into a balanced and cohesive mix.",
  },
  {
    number: "02",
    title: "Mastering",
    description:
      "Give the finished mix its final polish, balance and consistency before it reaches your audience.",
  },
  {
    number: "03",
    title: "Vocal Processing",
    description:
      "Shape the vocal presence within the production so that the performance connects naturally with the rest of the track.",
  },
  {
    number: "04",
    title: "Digital Release Preparation",
    description:
      "Prepare finished music for digital platforms including Spotify, Apple Music and YouTube.",
  },
];

const process = [
  {
    number: "01",
    title: "Listen",
    description:
      "We begin by understanding the production, the reference sound and what the track needs to communicate.",
  },
  {
    number: "02",
    title: "Balance",
    description:
      "Each element is shaped and positioned so vocals, instruments and production work together naturally.",
  },
  {
    number: "03",
    title: "Polish",
    description:
      "The final production is refined and prepared for release with attention to clarity, balance and consistency.",
  },
];
---

<Layout
  title="Mixing & Mastering Studio in Kolkata | Doremi Fusion"
  description="Doremi Fusion offers professional music mixing and mastering in Kolkata for songs and digital releases, including Spotify, Apple Music and YouTube."
  canonical="/services/mixing-mastering"
/>

<Navbar />

<main class="overflow-hidden bg-[#07080d] text-[#f5f5f7]">

  <!-- ===================================================== -->
  <!-- HERO -->
  <!-- ===================================================== -->

  <section class="relative border-b border-white/[0.10]">

    <div
      class="pointer-events-none absolute -left-48 top-24 h-[500px] w-[500px] rounded-full bg-purple-600/[0.045] blur-[150px]"
    ></div>

    <div
      class="pointer-events-none absolute -right-48 top-20 h-[500px] w-[500px] rounded-full bg-fuchsia-600/[0.025] blur-[150px]"
    ></div>


    <div
      class="relative mx-auto max-w-7xl px-6 pb-24 pt-32 sm:px-8 sm:pb-28 lg:px-12 lg:pb-32 lg:pt-36"
    >

      <!-- Breadcrumb -->

      <nav
        aria-label="Breadcrumb"
        class="mb-12 flex flex-wrap items-center gap-3 text-sm text-[#686a73]"
      >

        <a
          href="/"
          class="transition-colors duration-300 hover:text-[#f5f5f7]"
        >
          Home
        </a>

        <span class="text-white/20">
          /
        </span>

        <a
          href="/services"
          class="transition-colors duration-300 hover:text-[#f5f5f7]"
        >
          Services
        </a>

        <span class="text-white/20">
          /
        </span>

        <span class="text-[#a0a1a8]">
          Mixing & Mastering
        </span>

      </nav>


      <!-- Hero grid -->

      <div class="grid lg:grid-cols-12 lg:gap-16">

        <!-- LEFT -->

        <div class="lg:col-span-8">

          <p
            class="mb-7 text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
          >
            Mixing & Mastering
          </p>


          <h1
            class="max-w-[960px] text-[3.7rem] font-medium leading-[0.91] tracking-[-0.055em] text-[#f5f5f7] sm:text-6xl md:text-7xl lg:text-[6.5rem]"
          >
            Make every element

            <span class="block text-[#777983]">
              work together.
            </span>
          </h1>


          <!-- Editorial keywords -->

          <div class="mt-12 hidden items-center gap-7 sm:flex">

            <span class="h-px w-14 shrink-0 bg-white/40"></span>

            <div
              class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[9px] uppercase tracking-[0.34em] text-[#858790]"
            >

              <span>
                Balance
              </span>

              <span class="text-white/20">
                |
              </span>

              <span>
                Clarity
              </span>

              <span class="text-white/20">
                |
              </span>

              <span>
                Detail
              </span>

              <span class="text-white/20">
                |
              </span>

              <span>
                Final Sound
              </span>

            </div>

          </div>

        </div>


        <!-- RIGHT -->

        <div class="mt-14 lg:col-span-4 lg:mt-10">

          <div
            class="border-l border-white/[0.22] pl-7 sm:pl-9"
          >

            <p
              class="max-w-md text-base leading-8 text-[#9698a1] sm:text-lg sm:leading-9"
            >
              A finished production needs more than good individual sounds.
              Mixing and mastering bring the elements together and prepare
              your music for the platforms where people will hear it.
            </p>

          </div>


          <a
            href="#mixing"
            class="mt-10 inline-flex items-center gap-4 rounded-full border border-[#9b55c9]/60 px-6 py-3 text-[10px] font-medium uppercase tracking-[0.22em] text-[#e7e7eb] transition-all duration-300 hover:border-[#c875ff] hover:bg-purple-500/[0.06]"
          >

            Explore our process

            <span class="text-base text-[#c875ff]">
              ↗
            </span>

          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- THE MIX -->
  <!-- ===================================================== -->

  <section
    id="mixing"
    class="border-b border-white/[0.10]"
  >

    <div
      class="mx-auto max-w-7xl px-6 py-24 sm:px-8 sm:py-28 lg:px-12 lg:py-32"
    >

      <div class="grid gap-16 lg:grid-cols-12 lg:gap-20">

        <!-- LEFT -->

        <div class="lg:col-span-5">

          <p
            class="text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
          >
            The Mix
          </p>


          <h2
            class="mt-6 max-w-xl text-4xl font-medium leading-[1.02] tracking-[-0.045em] text-[#f5f5f7] sm:text-5xl lg:text-[4.2rem]"
          >
            Every element

            <span class="block text-[#777983]">
              has its place.
            </span>
          </h2>

        </div>


        <!-- RIGHT -->

        <div class="lg:col-span-7 lg:pt-3">

          <div
            class="max-w-2xl space-y-7 text-base leading-8 text-[#9698a1] sm:text-lg sm:leading-9"
          >

            <p>
              Mixing is where the individual parts of a production come
              together. Vocals, instruments and other musical elements need to
              work as one rather than compete with each other.
            </p>


            <p>
              At Doremi Fusion, mixing focuses on creating a balanced and
              cohesive final sound while preserving the character and emotion
              of the original production.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- FEATURE IMAGE -->
  <!-- ===================================================== -->

  <section class="border-b border-white/[0.10]">

    <div
      class="mx-auto max-w-7xl px-6 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24"
    >

      <div
        class="group relative overflow-hidden rounded-[2px] border border-white/[0.12]"
      >

        <img
          src="/images/studio/p5.webp"
          alt="Mixing and mastering at Doremi Fusion Music Studio in Kolkata"
          class="h-[380px] w-full object-cover transition-transform duration-700 group-hover:scale-[1.015] sm:h-[500px] lg:h-[640px]"
          loading="lazy"
        />


        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-transparent"
        ></div>


        <div
          class="absolute bottom-0 left-0 max-w-3xl p-7 sm:p-10 lg:p-14"
        >

          <p
            class="text-2xl font-medium leading-tight tracking-[-0.03em] text-[#f5f5f7] sm:text-3xl lg:text-4xl"
          >
            A great mix lets every part of the music breathe.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- WHAT WE DO -->
  <!-- ===================================================== -->

  <section class="border-b border-white/[0.10]">

    <div
      class="mx-auto max-w-7xl px-6 py-24 sm:px-8 sm:py-28 lg:px-12 lg:py-32"
    >

      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">

        <div class="lg:col-span-4">

          <p
            class="text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
          >
            What We Do
          </p>

        </div>


        <div class="lg:col-span-8">

          <h2
            class="max-w-3xl text-4xl font-medium leading-[1.05] tracking-[-0.04em] text-[#f5f5f7] sm:text-5xl"
          >
            A final sound built for listening.
          </h2>

        </div>

      </div>


      <!-- Service list -->

      <div
        class="mt-16 divide-y divide-white/[0.10] border-y border-white/[0.10]"
      >

        {
          serviceTypes.map((service) => (
            <article
              class="grid gap-6 py-9 sm:grid-cols-12 sm:gap-8 lg:py-11"
            >

              <div class="sm:col-span-2">

                <span class="text-xs tracking-wider text-[#666871]">
                  {service.number}
                </span>

              </div>


              <div class="sm:col-span-4">

                <h3
                  class="text-xl font-medium tracking-[-0.02em] text-[#f1f1f3] sm:text-2xl"
                >
                  {service.title}
                </h3>

              </div>


              <div class="sm:col-span-6">

                <p
                  class="max-w-xl text-sm leading-7 text-[#7f818a] sm:text-base sm:leading-8"
                >
                  {service.description}
                </p>

              </div>

            </article>
          ))
        }

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- OUR APPROACH -->
  <!-- ===================================================== -->

  <section class="border-b border-white/[0.10]">

    <div
      class="mx-auto max-w-7xl px-6 py-24 sm:px-8 sm:py-28 lg:px-12 lg:py-32"
    >

      <div class="grid gap-16 lg:grid-cols-12 lg:gap-20">

        <!-- LEFT -->

        <div class="lg:col-span-5">

          <p
            class="text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
          >
            Our Approach
          </p>


          <h2
            class="mt-6 max-w-xl text-4xl font-medium leading-[1.02] tracking-[-0.045em] text-[#f5f5f7] sm:text-5xl lg:text-[4.2rem]"
          >
            Clarity without

            <span class="block text-[#777983]">
              losing character.
            </span>
          </h2>

        </div>


        <!-- RIGHT -->

        <div class="lg:col-span-7 lg:pt-3">

          <div
            class="max-w-2xl space-y-7 text-base leading-8 text-[#9698a1] sm:text-lg sm:leading-9"
          >

            <p>
              Mixing and mastering should enhance a production without taking
              away what makes it unique. Every track has its own balance,
              character and emotional direction.
            </p>


            <p>
              The goal is to bring clarity and consistency to the finished
              music while keeping the identity of the original production
              intact.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- PROCESS -->
  <!-- ===================================================== -->

  <section class="border-b border-white/[0.10]">

    <div
      class="mx-auto max-w-7xl px-6 py-24 sm:px-8 sm:py-28 lg:px-12 lg:py-32"
    >

      <div class="mb-16">

        <p
          class="text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
        >
          The Process
        </p>


        <h2
          class="mt-6 max-w-4xl text-4xl font-medium leading-[1.05] tracking-[-0.04em] text-[#f5f5f7] sm:text-5xl"
        >
          From individual tracks to a finished release.
        </h2>

      </div>


      <div
        class="grid overflow-hidden rounded-[2px] border border-white/[0.12] md:grid-cols-3"
      >

        {
          process.map((step, index) => (
            <article
              class={`bg-[#0b0c11] p-8 sm:p-9 lg:p-11 ${
                index < process.length - 1
                  ? "border-b border-white/[0.10] md:border-b-0 md:border-r"
                  : ""
              }`}
            >

              <span class="text-xs tracking-wider text-[#c875ff]">
                {step.number}
              </span>


              <h3
                class="mt-16 text-xl font-medium tracking-[-0.025em] text-[#f1f1f3] sm:text-2xl"
              >
                {step.title}
              </h3>


              <p
                class="mt-4 text-sm leading-7 text-[#7f818a] sm:text-base sm:leading-8"
              >
                {step.description}
              </p>

            </article>
          ))
        }

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- BUILT FOR -->
  <!-- ===================================================== -->

  <section class="border-b border-white/[0.10]">

    <div
      class="mx-auto max-w-7xl px-6 py-24 sm:px-8 sm:py-28 lg:px-12 lg:py-32"
    >

      <div class="grid gap-16 lg:grid-cols-12 lg:gap-20">

        <!-- LEFT -->

        <div class="lg:col-span-5">

          <p
            class="text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
          >
            Built For
          </p>


          <h2
            class="mt-6 max-w-xl text-4xl font-medium leading-[1.05] tracking-[-0.04em] text-[#f5f5f7] sm:text-5xl"
          >
            Music ready

            <span class="block text-[#777983]">
              to be heard.
            </span>
          </h2>

        </div>


        <!-- RIGHT -->

        <div
          class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:col-span-7"
        >

          <div class="border-t border-white/[0.10] pt-5">

            <h3 class="font-medium text-[#f1f1f3]">
              Singles
            </h3>

            <p class="mt-3 text-sm leading-7 text-[#7f818a]">
              Give individual releases the balance and polish they need before
              reaching listeners.
            </p>

          </div>


          <div class="border-t border-white/[0.10] pt-5">

            <h3 class="font-medium text-[#f1f1f3]">
              Albums & EPs
            </h3>

            <p class="mt-3 text-sm leading-7 text-[#7f818a]">
              Create consistency across multiple tracks while preserving the
              character of each production.
            </p>

          </div>


          <div class="border-t border-white/[0.10] pt-5">

            <h3 class="font-medium text-[#f1f1f3]">
              Independent Artists
            </h3>

            <p class="mt-3 text-sm leading-7 text-[#7f818a]">
              Prepare finished music for distribution and digital audiences.
            </p>

          </div>


          <div class="border-t border-white/[0.10] pt-5">

            <h3 class="font-medium text-[#f1f1f3]">
              Digital Platforms
            </h3>

            <p class="mt-3 text-sm leading-7 text-[#7f818a]">
              Prepare music for platforms including Spotify, Apple Music and
              YouTube.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- RELATED SERVICES -->
  <!-- ===================================================== -->

  <section class="border-b border-white/[0.10]">

    <div
      class="mx-auto max-w-7xl px-6 py-24 sm:px-8 sm:py-28 lg:px-12 lg:py-32"
    >

      <p
        class="text-xs font-medium uppercase tracking-[0.34em] text-[#777983]"
      >
        Continue Exploring
      </p>


      <div class="mt-10 grid gap-5 sm:grid-cols-2">

        <!-- Music Production -->

        <a
          href="/services/music-production"
          class="group rounded-[2px] border border-white/[0.12] bg-white/[0.012] p-8 transition-all duration-300 hover:border-[#9b55c9]/50 hover:bg-white/[0.025] sm:p-10"
        >

          <span
            class="text-xs uppercase tracking-[0.2em] text-[#666871]"
          >
            Service 02
          </span>


          <h3
            class="mt-12 text-2xl font-medium tracking-[-0.025em] text-[#f1f1f3]"
          >
            Music Production
          </h3>


          <p
            class="mt-3 max-w-md text-sm leading-7 text-[#7f818a]"
          >
            Develop arrangements and complete productions for songs, films,
            web-series and creative projects.
          </p>


          <span
            class="mt-9 inline-block text-sm text-[#c875ff] transition-transform duration-300 group-hover:translate-x-1"
          >
            Explore service →
          </span>

        </a>


        <!-- Recording -->

        <a
          href="/services/recording"
          class="group rounded-[2px] border border-white/[0.12] bg-white/[0.012] p-8 transition-all duration-300 hover:border-[#9b55c9]/50 hover:bg-white/[0.025] sm:p-10"
        >

          <span
            class="text-xs uppercase tracking-[0.2em] text-[#666871]"
          >
            Service 01
          </span>


          <h3
            class="mt-12 text-2xl font-medium tracking-[-0.025em] text-[#f1f1f3]"
          >
            Recording
          </h3>


          <p
            class="mt-3 max-w-md text-sm leading-7 text-[#7f818a]"
          >
            Capture vocals, instruments, voiceovers, dubbing and live sessions.
          </p>


          <span
            class="mt-9 inline-block text-sm text-[#c875ff] transition-transform duration-300 group-hover:translate-x-1"
          >
            Explore service →
          </span>

        </a>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- CTA -->
  <!-- ===================================================== -->

  <section class="relative overflow-hidden">

    <div
      class="pointer-events-none absolute left-1/2 top-0 h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-purple-600/[0.045] blur-[140px]"
    ></div>


    <div
      class="relative mx-auto max-w-7xl px-6 py-28 sm:px-8 sm:py-32 lg:px-12 lg:py-40"
    >

      <p
        class="text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
      >
        Start A Project
      </p>


      <h2
        class="mt-6 max-w-5xl text-5xl font-medium leading-[0.95] tracking-[-0.05em] text-[#f5f5f7] sm:text-6xl lg:text-7xl"
      >
        Ready for the

        <span class="text-[#777983]">
          final sound?
        </span>
      </h2>


      <p
        class="mt-8 max-w-xl text-base leading-8 text-[#9698a1] sm:text-lg"
      >
        Send us your production and tell us where you want the finished music
        to go.
      </p>


      <a
        href="/contact"
        class="mt-10 inline-flex items-center gap-4 rounded-full bg-[#f5f5f7] px-7 py-3.5 text-sm font-medium text-[#07080d] transition-all duration-300 hover:bg-[#e8c9f7]"
      >
        Discuss your project

        <span>
          ↗
        </span>

      </a>

    </div>

  </section>

</main>


<Footer />


<!-- ===================================================== -->
<!-- STRUCTURED DATA -->
<!-- ===================================================== -->

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://doremifusion.in/services/mixing-mastering",
        "url": "https://doremifusion.in/services/mixing-mastering",
        "name": "Mixing & Mastering Studio in Kolkata | Doremi Fusion",
        "description": "Doremi Fusion offers professional music mixing and mastering in Kolkata for songs and digital releases.",
        "isPartOf": {
          "@type": "WebSite",
          "name": "Doremi Fusion",
          "url": "https://doremifusion.in"
        }
      },
      {
        "@type": "Service",
        "name": "Mixing & Mastering",
        "serviceType": "Music Mixing and Mastering",
        "description": "Professional music mixing and mastering for songs and digital releases.",
        "provider": {
          "@type": "LocalBusiness",
          "name": "Doremi Fusion",
          "url": "https://doremifusion.in",
          "address": {
            "@type": "PostalAddress",
