---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const siteUrl = "https://doremifusion.in";

const title = "Music Studio Services in Kolkata | Doremi Fusion";

const description =
  "Explore Doremi Fusion's music studio services in Kolkata, including professional recording, music production, mixing and mastering, music classes, and jam sessions.";

const canonical = `${siteUrl}/services`;

const services = [
  {
    number: "01",
    title: "Recording",
    shortTitle: "Recording",
    description:
      "Capture vocals, instruments, voiceovers, dubbing and live sessions in a focused studio environment.",
    href: "/services/recording",
    label: "Explore recording",
    image: "/images/services-page/recording.png",
    caption: "CAPTURE EVERY DETAIL",
  },
  {
    number: "02",
    title: "Music Production",
    shortTitle: "Production",
    description:
      "Develop musical ideas, arrangements and compositions into complete productions for songs and creative projects.",
    href: "/services/music-production",
    label: "Explore production",
    image: "/images/services-page/music-production.png",
    caption: "FROM IDEA TO SOUND",
  },
  {
    number: "03",
    title: "Mixing & Mastering",
    shortTitle: "Mixing",
    description:
      "Refine balance, dynamics and sonic character and prepare finished music for digital listening.",
    href: "/services/mixing-mastering",
    label: "Explore mixing",
    image: "/images/studio/p6.webp",
    caption: "SHAPE THE FINAL SOUND",
  },
  {
    number: "04",
    title: "Music Classes",
    shortTitle: "Classes",
    description:
      "Learn guitar, ukulele, drums and bass guitar through practical, studio-based musical learning.",
    href: "/services/music-classes",
    label: "View classes",
    image: "/images/services-page/music-classes.png",
    caption: "LEARN · PLAY · CREATE",
  },
  {
    number: "05",
    title: "Jam Pad",
    shortTitle: "Jam Pad",
    description:
      "A focused space for musicians and bands to rehearse, experiment, collaborate and play together.",
    href: "/services/jam-pad",
    label: "View jam pad",
    image: "/images/services-page/jam.jpg",
    caption: "PLAY TOGETHER",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: {
        "@id": `${siteUrl}#website`,
      },
      breadcrumb: {
        "@id": `${canonical}#breadcrumb`,
      },
      mainEntity: {
        "@id": `${canonical}#services`,
      },
    },

    {
      "@type": "ItemList",
      "@id": `${canonical}#services`,
      name: "Doremi Fusion Music Studio Services",
      numberOfItems: services.length,
      itemListElement: services.map((service, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: service.title,
        url: service.href.startsWith("#")
          ? `${canonical}${service.href}`
          : `${siteUrl}${service.href}`,
      })),
    },

    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${siteUrl}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Services",
          item: canonical,
        },
      ],
    },

    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Doremi Fusion Music Studio",
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical="/services"
  ogImage="/images/studio/p3.webp"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <Navbar />

  <main class="overflow-hidden bg-[#07080d] text-[#f5f5f7]">

    <!-- ===================================================== -->
    <!-- HERO -->
    <!-- ===================================================== -->

    <section class="relative border-b border-white/[0.10]">

      <!-- Ambient glow -->

      <div
        class="pointer-events-none absolute -left-64 top-32 h-[32rem] w-[32rem] rounded-full bg-purple-600/[0.045] blur-[170px]"
      ></div>

      <div
        class="pointer-events-none absolute -right-64 top-0 h-[34rem] w-[34rem] rounded-full bg-fuchsia-600/[0.025] blur-[180px]"
      ></div>

      <div
        class="relative mx-auto max-w-7xl px-6 pb-24 pt-28 sm:px-8 sm:pb-28 lg:px-12 lg:pb-32 lg:pt-32"
      >

        <!-- Breadcrumb -->

        <nav
          aria-label="Breadcrumb"
          class="services-reveal mb-12"
        >
          <ol
            class="flex items-center gap-3 text-[10px] uppercase tracking-[0.25em] text-white/40 sm:text-xs"
          >
            <li>
              <a
                href="/"
                class="transition-colors duration-300 hover:text-white/80"
              >
                Home
              </a>
            </li>

            <li
              aria-hidden="true"
              class="text-[#c875ff]"
            >
              /
            </li>

            <li
              aria-current="page"
              class="text-white/70"
            >
              Services
            </li>
          </ol>
        </nav>


        <!-- Hero content -->

        <div class="grid gap-14 lg:grid-cols-12 lg:items-end">

          <!-- Left -->

          <div class="services-reveal lg:col-span-8">

            <p
              class="mb-7 text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
            >
              Music Studio Services · Kolkata
            </p>

            <h1
              class="max-w-[950px] text-[3.7rem] font-medium leading-[0.91] tracking-[-0.055em] text-[#f5f5f7] sm:text-6xl md:text-7xl lg:text-[6.4rem]"
            >
              Sound built

              <span class="block text-[#777983]">
                around your vision<span class="text-[#c875ff]">.</span>
              </span>
            </h1>


            <!-- Editorial keywords -->

            <div class="mt-12 hidden items-center gap-7 sm:flex">

              <span class="h-px w-14 bg-white/35"></span>

              <div
                class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[9px] uppercase tracking-[0.34em] text-[#777983]"
              >
                <span>Recording</span>

                <span class="text-white/20">|</span>

                <span>Production</span>

                <span class="text-white/20">|</span>

                <span>Mixing</span>

                <span class="text-white/20">|</span>

                <span>Learning</span>
              </div>

            </div>

          </div>


          <!-- Right -->

          <div
            class="services-reveal services-delay-1 lg:col-span-4 lg:col-start-9"
          >

            <div class="border-l border-white/[0.22] pl-7 sm:pl-9">

              <p
                class="max-w-md text-base leading-8 text-[#9698a1] sm:text-lg sm:leading-9"
              >
                From recording and production to learning and rehearsal,
                Doremi Fusion provides a focused environment for different
                stages of the musical process.
              </p>

            </div>


            <a
              href="#services"
              class="mt-9 inline-flex items-center gap-4 rounded-full border border-[#9b55c9]/60 px-6 py-3 text-[10px] font-medium uppercase tracking-[0.22em] text-[#e7e7eb] transition-all duration-300 hover:border-[#c875ff] hover:bg-purple-500/[0.06]"
            >
              Explore our services

              <span class="text-base text-[#c875ff]">
                ↘
              </span>
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- ===================================================== -->
    <!-- INTRO -->
    <!-- ===================================================== -->

    <section class="border-b border-white/[0.10]">

      <div
        class="mx-auto max-w-7xl px-6 py-24 sm:px-8 sm:py-28 lg:px-12 lg:py-32"
      >

        <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">

          <!-- Left -->

          <div class="services-reveal lg:col-span-5">

            <p
              class="text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
            >
              The Work
            </p>

            <h2
              class="mt-6 max-w-xl text-4xl font-medium leading-[1.02] tracking-[-0.045em] text-[#f5f5f7] sm:text-5xl lg:text-[4.3rem]"
            >
              One studio.

              <span class="block text-[#777983]">
                Different possibilities.
              </span>
            </h2>

          </div>


          <!-- Right -->

          <div
            class="services-reveal services-delay-1 lg:col-span-7 lg:pt-3"
          >

            <div
              class="max-w-2xl space-y-7 text-base leading-8 text-[#9698a1] sm:text-lg sm:leading-9"
            >

              <p>
                Every project has a different starting point. Sometimes it
                begins with a performance. Sometimes it starts with an idea,
                an unfinished arrangement or a desire to learn.
              </p>

              <p>
                Our services are built to support those different stages
                without losing sight of the music itself.
              </p>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- ===================================================== -->
    <!-- SERVICES — ZIG ZAG -->
    <!-- ===================================================== -->

    <section
      id="services"
      class="scroll-mt-20 border-b border-white/[0.10] bg-[#101016]"
    >

      <div
        class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-32 lg:px-10 lg:py-40"
      >

        <!-- Section heading -->

        <div
          class="grid gap-10 lg:grid-cols-12 lg:items-end"
        >

          <div class="services-reveal lg:col-span-7">

            <p
              class="mb-5 text-[10px] font-medium uppercase tracking-[0.3em] text-[#d8b4fe] sm:text-xs sm:tracking-[0.38em]"
            >
              What We Create
            </p>

            <h2
              class="max-w-4xl text-[2.8rem] font-semibold leading-[0.94] tracking-[-0.045em] text-[#f5f5f7] sm:text-5xl lg:text-[5.3rem]"
            >
              From the first idea.

              <span class="block text-white/50">
                To the finished sound<span class="text-[#d946ef]">.</span>
              </span>
            </h2>

          </div>


          <div
            class="services-reveal services-delay-1 lg:col-span-4 lg:col-start-9 lg:pb-2"
          >

            <p
              class="max-w-md text-[15px] leading-7 text-white/60 sm:text-base sm:leading-8"
            >
              Different projects need different approaches. Explore the ways
              Doremi Fusion helps artists record, create, refine, learn and
              play.
            </p>

          </div>

        </div>


        <!-- ================================================= -->
        <!-- ZIG ZAG SERVICE ITEMS -->
        <!-- ================================================= -->

        <div class="mt-20 sm:mt-28 lg:mt-36">

          {
            services.slice(0, 4).map((service, index) => {
              const imageLeft = index % 2 === 0;

              return (
                <article
                  class={`service-zig-row services-reveal ${
                    index !== 3
                      ? "mb-24 sm:mb-32 lg:mb-40"
                      : "mb-24 sm:mb-32 lg:mb-40"
                  }`}
                >

                  {imageLeft ? (
                    <>
                      <!-- IMAGE LEFT -->

                      <div class="service-zig-image-wrap">

                        <div class="service-zig-frame">

                          <span class="service-zig-line service-zig-line-top"></span>

                          <span class="service-zig-line service-zig-line-side"></span>

                          <div class="service-zig-image-container">

                            <img
                              src={service.image}
                              alt={`${service.title} at Doremi Fusion Music Studio in Kolkata`}
                              loading="lazy"
                              decoding="async"
                              class="service-zig-image"
                            />

                            <div
                              class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"
                            ></div>


                            <div
                              class="absolute bottom-5 left-5 z-20 sm:bottom-7 sm:left-7"
                            >
                              <p
                                class="text-[9px] font-medium uppercase tracking-[0.28em] text-white/85 sm:text-[10px] sm:tracking-[0.32em]"
                              >
                                {service.caption}
                              </p>
                            </div>

                          </div>

                        </div>

                      </div>


                      <!-- TEXT RIGHT -->

                      <div class="service-zig-content">

                        <div class="mb-7 flex items-center gap-4">

                          <span
                            class="text-[10px] font-medium tracking-[0.22em] text-[#d8b4fe]"
                          >
                            {service.number}
                          </span>

                          <span
                            class="h-px w-16 bg-white/[0.18]"
                          ></span>

                        </div>


                        <h3
                          class="text-[2.35rem] font-medium leading-[0.95] tracking-[-0.04em] text-[#f5f5f7] sm:text-5xl lg:text-[3.5rem]"
                        >
                          {service.title}
                        </h3>


                        <p
                          class="mt-6 max-w-lg text-[15px] leading-7 text-white/60 sm:text-base sm:leading-8"
                        >
                          {service.description}
                        </p>


                        <a
                          href={service.href}
                          class="group mt-8 inline-flex items-center gap-4 text-[9px] font-medium uppercase tracking-[0.3em] text-[#d8b4fe] transition-colors duration-300 hover:text-white sm:text-[10px]"
                        >
                          <span>
                            Learn more
                          </span>

                          <span
                            class="text-sm text-[#c875ff] transition-transform duration-300 group-hover:translate-x-1"
                          >
                            →
                          </span>
                        </a>

                      </div>
                    </>
                  ) : (
                    <>
                      <!-- TEXT LEFT -->

                      <div class="service-zig-content">

                        <div class="mb-7 flex items-center gap-4">

                          <span
                            class="text-[10px] font-medium tracking-[0.22em] text-[#d8b4fe]"
                          >
                            {service.number}
                          </span>

                          <span
                            class="h-px w-16 bg-white/[0.18]"
                          ></span>

                        </div>


                        <h3
                          class="text-[2.35rem] font-medium leading-[0.95] tracking-[-0.04em] text-[#f5f5f7] sm:text-5xl lg:text-[3.5rem]"
                        >
                          {service.title}
                        </h3>


                        <p
                          class="mt-6 max-w-lg text-[15px] leading-7 text-white/60 sm:text-base sm:leading-8"
                        >
                          {service.description}
                        </p>


                        <a
                          href={service.href}
                          class="group mt-8 inline-flex items-center gap-4 text-[9px] font-medium uppercase tracking-[0.3em] text-[#d8b4fe] transition-colors duration-300 hover:text-white sm:text-[10px]"
                        >
                          <span>
                            Learn more
                          </span>

                          <span
                            class="text-sm text-[#c875ff] transition-transform duration-300 group-hover:translate-x-1"
                          >
                            →
                          </span>
                        </a>

                      </div>


                      <!-- IMAGE RIGHT -->

                      <div class="service-zig-image-wrap">

                        <div
                          class="service-zig-frame service-zig-frame-right"
                        >

                          <span
                            class="service-zig-line service-zig-line-top service-zig-line-right"
                          ></span>

                          <span
                            class="service-zig-line service-zig-line-side service-zig-line-side-right"
                          ></span>


                          <div class="service-zig-image-container">

                            <img
                              src={service.image}
                              alt={`${service.title} at Doremi Fusion Music Studio in Kolkata`}
                              loading="lazy"
                              decoding="async"
                              class="service-zig-image"
                            />

                            <div
                              class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"
                            ></div>


                            <div
                              class="absolute bottom-5 right-5 z-20 text-right sm:bottom-7 sm:right-7"
                            >
                              <p
                                class="text-[9px] font-medium uppercase tracking-[0.28em] text-white/85 sm:text-[10px] sm:tracking-[0.32em]"
                              >
                                {service.caption}
                              </p>
                            </div>

                          </div>

                        </div>

                      </div>
                    </>
                  )}

                </article>
              );
            })
          }


          <!-- ================================================= -->
          <!-- FIFTH SERVICE — JAM PAD -->
          <!-- ================================================= -->

          <article class="service-jam-feature services-reveal">

            <div class="service-jam-image">

              <div class="service-zig-frame">

                <span class="service-zig-line service-zig-line-top"></span>

                <span class="service-zig-line service-zig-line-side"></span>


                <div class="service-zig-image-container">

                  <img
                    src={services[4].image}
                    alt="Jam Pad at Doremi Fusion Music Studio in Kolkata"
                    loading="lazy"
                    decoding="async"
                    class="service-zig-image"
                  />

                  <div
                    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"
                  ></div>


                  <div
                    class="absolute bottom-5 left-5 z-20 sm:bottom-7 sm:left-7"
                  >
                    <p
                      class="text-[9px] font-medium uppercase tracking-[0.28em] text-white/85 sm:text-[10px] sm:tracking-[0.32em]"
                    >
                      {services[4].caption}
                    </p>
                  </div>

                </div>

              </div>

            </div>


            <div class="service-jam-content">

              <div class="mb-7 flex items-center gap-4">

                <span
                  class="text-[10px] font-medium tracking-[0.22em] text-[#d8b4fe]"
                >
                  {services[4].number}
                </span>

                <span
                  class="h-px w-16 bg-white/[0.18]"
                ></span>

              </div>


              <p
                class="mb-4 text-[9px] font-medium uppercase tracking-[0.3em] text-[#777983]"
              >
                Rehearsal Space
              </p>


              <h3
                class="text-[2.4rem] font-medium leading-[0.95] tracking-[-0.04em] text-[#f5f5f7] sm:text-5xl lg:text-[3.8rem]"
              >
                {services[4].title}
              </h3>


              <p
                class="mt-6 max-w-xl text-[15px] leading-7 text-white/60 sm:text-base sm:leading-8"
              >
                {services[4].description}
              </p>


              <a
                href={services[4].href}
                class="group mt-8 inline-flex items-center gap-4 text-[9px] font-medium uppercase tracking-[0.3em] text-[#d8b4fe] transition-colors duration-300 hover:text-white sm:text-[10px]"
              >
                <span>
                  Explore Jam Pad
                </span>

                <span
                  class="text-sm text-[#c875ff] transition-transform duration-300 group-hover:translate-x-1"
                >
                  →
                </span>
              </a>

            </div>

          </article>

        </div>


        <!-- ================================================= -->
        <!-- BOTTOM STATEMENT -->
        <!-- ================================================= -->

        <div
          class="services-reveal mt-16 border-t border-white/[0.1] pt-8 sm:mt-20 sm:pt-10"
        >

          <div class="flex items-center gap-5">

            <span
              class="h-px w-8 bg-[#c875ff] sm:w-10"
            ></span>

            <p
              class="text-[9px] font-medium uppercase tracking-[0.25em] text-white/50 sm:text-[10px] sm:tracking-[0.32em]"
            >
              Record. Create. Refine. Learn. Play.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- ===================================================== -->
    <!-- FEATURE IMAGE -->
    <!-- ===================================================== -->

    <section class="border-b border-white/[0.10]">

      <div
        class="mx-auto max-w-7xl px-6 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24"
      >

        <div
          class="services-image-reveal group relative overflow-hidden border border-white/[0.12]"
        >

          <img
            src="/images/studio/p3.webp"
            alt="Music studio environment at Doremi Fusion in Kolkata"
            loading="lazy"
            decoding="async"
            class="h-[360px] w-full object-cover transition-transform duration-1000 ease-out group-hover:scale-[1.015] sm:h-[500px] lg:h-[620px]"
          />


          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"
          ></div>


          <div
            class="absolute bottom-0 left-0 p-7 sm:p-10 lg:p-14"
          >

            <p
              class="max-w-2xl text-2xl font-medium leading-tight tracking-[-0.03em] text-[#f5f5f7] sm:text-3xl lg:text-4xl"
            >
              Different projects.

              <span class="text-white/55">
                One place to build them.
              </span>
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- ===================================================== -->
    <!-- HOW WE WORK -->
    <!-- ===================================================== -->

    <section class="border-b border-white/[0.10]">

      <div
        class="mx-auto max-w-7xl px-6 py-24 sm:px-8 sm:py-28 lg:px-12 lg:py-32"
      >

        <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">

          <!-- Left -->

          <div class="services-reveal lg:col-span-5">

            <p
              class="text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
            >
              Our Approach
            </p>


            <h2
              class="mt-6 max-w-xl text-4xl font-medium leading-[1.02] tracking-[-0.045em] text-[#f5f5f7] sm:text-5xl lg:text-[4.2rem]"
            >
              Start with the

              <span class="block text-[#777983]">
                music.
              </span>
            </h2>

          </div>


          <!-- Right -->

          <div
            class="services-reveal services-delay-1 lg:col-span-7 lg:pt-3"
          >

            <div
              class="max-w-2xl space-y-7 text-base leading-8 text-[#9698a1] sm:text-lg sm:leading-9"
            >

              <p>
                There is no single formula for making music. Our role is to
                understand what you are trying to create and provide the
                technical environment to help move it forward.
              </p>

              <p>
                Whether you are recording a performance, developing a
                production, refining a finished track or learning an
                instrument, the process begins with understanding the music.
              </p>

            </div>

          </div>

        </div>


        <!-- Process -->

        <div
          class="mt-16 grid overflow-hidden border border-white/[0.12] sm:mt-20 sm:grid-cols-3"
        >

          <article
            class="services-card border-b border-white/[0.10] bg-[#0b0c11] p-8 sm:border-b-0 sm:border-r sm:p-10"
          >

            <span
              class="text-xs tracking-[0.12em] text-[#c875ff]"
            >
              01
            </span>

            <h3
              class="mt-16 text-xl font-medium tracking-[-0.025em] text-[#f1f1f3] sm:text-2xl"
            >
              Understand
            </h3>

            <p
              class="mt-4 text-sm leading-7 text-[#7f818a] sm:text-base sm:leading-8"
            >
              Begin with the project, the music and the direction behind it.
            </p>

          </article>


          <article
            class="services-card services-delay-1 border-b border-white/[0.10] bg-[#0b0c11] p-8 sm:border-b-0 sm:border-r sm:p-10"
          >

            <span
              class="text-xs tracking-[0.12em] text-[#c875ff]"
            >
              02
            </span>

            <h3
              class="mt-16 text-xl font-medium tracking-[-0.025em] text-[#f1f1f3] sm:text-2xl"
            >
              Create
            </h3>

            <p
              class="mt-4 text-sm leading-7 text-[#7f818a] sm:text-base sm:leading-8"
            >
              Recording, production and creative decisions shape the project
              from idea to execution.
            </p>

          </article>


          <article
            class="services-card services-delay-2 bg-[#0b0c11] p-8 sm:p-10"
