<section
  id="studio-profile"
  class="relative overflow-hidden bg-[#050506] py-20 sm:py-32 lg:py-44"
>
  <!-- Ambient glow -->
  <div
    class="pointer-events-none absolute -right-48 top-1/4 h-[32rem] w-[32rem] rounded-full bg-[#a855f7]/[0.035] blur-[160px]"
  ></div>

  <div class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">

    <!-- ========================================================= -->
    <!-- SECTION HEADING -->
    <!-- ========================================================= -->

    <div class="grid gap-8 sm:gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p
          class="mb-5 text-[10px] font-medium uppercase tracking-[0.38em] text-[#c084fc] sm:mb-6 sm:text-xs"
        >
          The sound behind the studio
        </p>

        <h2
          class="max-w-5xl text-5xl font-semibold leading-[0.94] tracking-[-0.045em] text-white sm:text-6xl lg:text-[5.8rem]"
        >
          Technical skill.
          <span class="block text-white/35">
            Creative instinct<span class="text-[#d946ef]">.</span>
          </span>
        </h2>
      </div>

      <div class="lg:col-span-3 lg:col-start-10">
        <p
          class="max-w-md text-sm leading-7 text-white/50 sm:text-base sm:leading-8"
        >
          Meet the sound engineer and music arranger shaping the work at
          Doremi Fusion.
        </p>
      </div>
    </div>


    <!-- ========================================================= -->
    <!-- PROFILE -->
    <!-- ========================================================= -->

    <div
      class="mt-14 grid gap-10 sm:mt-20 sm:gap-12 lg:mt-28 lg:grid-cols-12 lg:items-start lg:gap-0"
    >

      <!-- Image -->
      <div class="lg:col-span-7">
        <div class="group relative overflow-hidden">
          <div
            class="absolute inset-0 z-10 bg-gradient-to-t from-black/40 via-transparent to-transparent"
          ></div>

          <img
            src="/images/studio/d2.JPG"
            alt="Rishiraj Basu working at Doremi Fusion Music Studio in Kolkata"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
          />

          <div class="absolute bottom-4 left-4 z-20 sm:bottom-6 sm:left-6">
            <p
              class="text-[9px] uppercase tracking-[0.3em] text-white/55 sm:text-xs"
            >
              Doremi Fusion · Kolkata
            </p>
          </div>
        </div>
      </div>


      <!-- Profile information -->
      <div class="lg:col-span-4 lg:col-start-9 lg:pt-1">
        <div class="border-l border-white/10 pl-5 sm:pl-8">

          <p
            class="text-[10px] uppercase tracking-[0.28em] text-[#c084fc] sm:text-xs"
          >
            Rishiraj Basu
          </p>

          <h3
            class="mt-3 text-3xl font-medium leading-tight tracking-[-0.025em] text-white sm:text-4xl"
          >
            Sound Engineer
            <span class="block text-white/40">
              &amp; Music Arranger
            </span>
          </h3>

          <p
            class="mt-6 text-sm leading-7 text-white/70 sm:mt-8 sm:text-lg sm:leading-9"
          >
            Rishiraj brings hands-on experience in live sound engineering,
            music production and arrangement to Doremi Fusion.
          </p>

          <p
            class="mt-5 text-sm leading-7 text-white/50 sm:mt-6 sm:text-base sm:leading-8"
          >
            Based in Kolkata, his work combines technical precision with a
            strong understanding of regional sounds and musical expression.
          </p>

          <p
            class="mt-5 text-sm leading-7 text-white/50 sm:mt-6 sm:text-base sm:leading-8"
          >
            His work includes music arrangements for Assamese tracks such as
            Akha, Thikona and Bonoriya Gaan.
          </p>

        </div>
      </div>
    </div>


    <!-- ========================================================= -->
    <!-- SELECTED WORK -->
    <!-- ========================================================= -->

    <div
      class="mt-20 border-t border-white/[0.08] pt-8 sm:mt-28 sm:pt-12 lg:mt-32"
    >

      <div
        class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
      >

        <div>
          <p
            class="text-[10px] uppercase tracking-[0.3em] text-white/30 sm:text-xs"
          >
            Selected work
          </p>

          <h3
            class="mt-2 text-2xl font-medium tracking-[-0.02em] text-white sm:mt-3 sm:text-3xl"
          >
            Hear the work in action.
          </h3>
        </div>

        <p
          class="text-[9px] uppercase tracking-[0.22em] text-white/25 sm:text-xs"
        >
          Music · Arrangement · Production
        </p>
      </div>


      <!-- YouTube works -->
      <div class="mt-8 grid gap-6 sm:mt-10 md:grid-cols-3 md:gap-5">

        <!-- ===================================================== -->
        <!-- WORK 01 -->
        <!-- ===================================================== -->

        <a
          href="https://www.youtube.com/watch?v=nBSPzr3RaWo"
          target="_blank"
          rel="noopener noreferrer"
          class="group block"
          aria-label="Watch Akha by Rishiraj on YouTube"
        >
          <div
            class="relative overflow-hidden border border-white/[0.08] bg-[#0b0b0d]"
          >
            <div class="aspect-video">
              <img
                src="https://img.youtube.com/vi/nBSPzr3RaWo/hqdefault.jpg"
                alt="Akha — music work by Rishiraj Basu"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover opacity-75 transition duration-500 group-hover:scale-[1.03] group-hover:opacity-100"
              />
            </div>

            <div
              class="absolute inset-0 flex items-center justify-center bg-black/20"
            >
              <span
                class="flex h-11 w-11 items-center justify-center rounded-full border border-white/30 bg-black/50 text-sm text-white backdrop-blur-sm transition-transform duration-300 group-hover:scale-110 sm:h-12 sm:w-12"
              >
                ▶
              </span>
            </div>
          </div>

          <div class="mt-3 flex items-center justify-between sm:mt-4">
            <p class="text-sm text-white/70">
              Akha
            </p>

            <span class="text-[10px] text-white/25 sm:text-xs">
              01
            </span>
          </div>
        </a>


        <!-- ===================================================== -->
        <!-- WORK 02 -->
        <!-- ===================================================== -->

        <a
          href="https://www.youtube.com/watch?v=yWGtZxYLfu0"
          target="_blank"
          rel="noopener noreferrer"
          class="group block"
          aria-label="Watch Bonoriya Gaan by Rishiraj on YouTube"
        >
          <div
            class="relative overflow-hidden border border-white/[0.08] bg-[#0b0b0d]"
          >
            <div class="aspect-video">
              <img
                src="https://img.youtube.com/vi/yWGtZxYLfu0/hqdefault.jpg"
                alt="Bonoriya Gaan — music work by Rishiraj Basu"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover opacity-75 transition duration-500 group-hover:scale-[1.03] group-hover:opacity-100"
              />
            </div>

            <div
              class="absolute inset-0 flex items-center justify-center bg-black/20"
            >
              <span
                class="flex h-11 w-11 items-center justify-center rounded-full border border-white/30 bg-black/50 text-sm text-white backdrop-blur-sm transition-transform duration-300 group-hover:scale-110 sm:h-12 sm:w-12"
              >
                ▶
              </span>
            </div>
          </div>

          <div class="mt-3 flex items-center justify-between sm:mt-4">
            <p class="text-sm text-white/70">
              Bonoriya Gaan
            </p>

            <span class="text-[10px] text-white/25 sm:text-xs">
              02
            </span>
          </div>
        </a>


        <!-- ===================================================== -->
        <!-- WORK 03 -->
        <!-- ===================================================== -->

        <a
          href="https://www.youtube.com/watch?v=DbUq3W0xC6Y"
          target="_blank"
          rel="noopener noreferrer"
          class="group block"
          aria-label="Watch Thikona by Rishiraj on YouTube"
        >
          <div
            class="relative overflow-hidden border border-white/[0.08] bg-[#0b0b0d]"
          >
            <div class="aspect-video">
              <img
                src="https://img.youtube.com/vi/DbUq3W0xC6Y/hqdefault.jpg"
                alt="Thikona — music work by Rishiraj Basu"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover opacity-75 transition duration-500 group-hover:scale-[1.03] group-hover:opacity-100"
              />
            </div>

            <div
              class="absolute inset-0 flex items-center justify-center bg-black/20"
            >
              <span
                class="flex h-11 w-11 items-center justify-center rounded-full border border-white/30 bg-black/50 text-sm text-white backdrop-blur-sm transition-transform duration-300 group-hover:scale-110 sm:h-12 sm:w-12"
              >
                ▶
              </span>
            </div>
          </div>

          <div class="mt-3 flex items-center justify-between sm:mt-4">
            <p class="text-sm text-white/70">
              Thikona
            </p>

            <span class="text-[10px] text-white/25 sm:text-xs">
              03
            </span>
          </div>
        </a>

      </div>
    </div>


    <!-- ========================================================= -->
    <!-- SECTION FOOTER -->
    <!-- ========================================================= -->

    <div
      class="mt-16 flex flex-col gap-4 border-t border-white/[0.08] pt-7 sm:mt-24 sm:flex-row sm:items-center sm:justify-between sm:pt-8"
    >
      <p
        class="text-[9px] uppercase tracking-[0.28em] text-white/25 sm:text-xs"
      >
        Sound · Arrangement · Production
      </p>

      <p
        class="text-[9px] uppercase tracking-[0.28em] text-white/25 sm:text-xs"
      >
        Doremi Fusion
      </p>
    </div>

  </div>
</section>