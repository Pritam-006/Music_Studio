---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import GalleryLightbox from "../components/Gallerylightbox.astro";

const galleryImages = [
  {
    src: "/images/studio/p1.webp",
    alt: "Doremi Fusion music studio recording room in Kolkata",
    category: "The Studio",
    number: "01",
    caption:
      "A space built around sound, creativity and musical expression.",
  },
  {
    src: "/images/studio/p3.webp",
    alt: "Microphone and recording equipment at Doremi Fusion Music Studio",
    category: "Recording",
    number: "02",
    caption:
      "Where performances become recordings.",
  },
  {
    src: "/images/studio/p4.webp",
    alt: "Audio mixing equipment inside Doremi Fusion Music Studio",
    category: "Production",
    number: "03",
    caption:
      "The details behind the production.",
  },
  {
    src: "/images/studio/p5.webp",
    alt: "Music equipment inside Doremi Fusion Music Studio",
    category: "Equipment",
    number: "04",
    caption:
      "Tools that help shape the final sound.",
  },
  {
    src: "/images/studio/p6.webp",
    alt: "Musical instruments at Doremi Fusion Music Studio",
    category: "Instruments",
    number: "05",
    caption:
      "Instruments, ideas and room to play.",
  },
];
---

<Layout
  title="Doremi Fusion Gallery | Music Studio in Kolkata"
  description="Explore the Doremi Fusion music studio in Kolkata through photographs of the recording space, equipment, instruments and creative environment."
  canonical="/gallery"
>

  <Navbar />


  <main class="overflow-hidden bg-[#0d0b12] text-[#f7f3fa]">

    <!-- ===================================================== -->
    <!-- HERO -->
    <!-- ===================================================== -->

    <section
      class="relative border-b border-[#d8b4fe]/[0.12]"
    >

      <div
        class="pointer-events-none absolute -left-64 top-16 h-[34rem] w-[34rem] rounded-full bg-[#b45cff]/[0.055] blur-[170px]"
      ></div>


      <div
        class="pointer-events-none absolute -right-64 top-24 h-[32rem] w-[32rem] rounded-full bg-[#d95bea]/[0.035] blur-[170px]"
      ></div>


      <div
        class="relative mx-auto max-w-7xl px-6 pb-24 pt-28 sm:px-8 sm:pb-28 lg:px-12 lg:pb-32 lg:pt-32"
      >

        <!-- Breadcrumb -->

        <nav
          aria-label="Breadcrumb"
          class="mb-14"
        >

          <ol
            class="flex items-center gap-3 text-[10px] uppercase tracking-[0.25em] text-[#817989] sm:text-xs"
          >

            <li>

              <a
                href="/"
                class="transition-colors duration-300 hover:text-[#f7f3fa]"
              >
                Home
              </a>

            </li>


            <li
              aria-hidden="true"
              class="text-[#b45cff]"
            >
              /
            </li>


            <li class="text-[#b9b1c1]">
              Gallery
            </li>

          </ol>

        </nav>


        <!-- Hero content -->

        <div
          class="grid gap-14 lg:grid-cols-12 lg:items-end"
        >

          <!-- Left -->

          <div class="lg:col-span-8">

            <p
              class="mb-7 text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
            >
              Inside Doremi Fusion
            </p>


            <h1
              class="max-w-[950px] text-[3.8rem] font-medium leading-[0.9] tracking-[-0.055em] text-[#f7f3fa] sm:text-6xl md:text-7xl lg:text-[6.5rem]"
            >
              A space built

              <span class="block text-[#827b8b]">
                for sound<span class="text-[#c875ff]">.</span>
              </span>
            </h1>


            <div
              class="mt-12 hidden items-center gap-7 sm:flex"
            >

              <span
                class="h-px w-14 bg-[#f7f3fa]/30"
              ></span>


              <div
                class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[9px] uppercase tracking-[0.34em] text-[#827b8b]"
              >

                <span>Recording</span>

                <span class="text-[#f7f3fa]/20">
                  |
                </span>

                <span>Production</span>

                <span class="text-[#f7f3fa]/20">
                  |
                </span>

                <span>Instruments</span>

                <span class="text-[#f7f3fa]/20">
                  |
                </span>

                <span>Expression</span>

              </div>

            </div>

          </div>


          <!-- Right -->

          <div
            class="lg:col-span-4 lg:pt-10"
          >

            <div
              class="border-l border-[#d8b4fe]/[0.22] pl-7 sm:pl-9"
            >

              <p
                class="max-w-md text-base leading-8 text-[#a8a1b0] sm:text-lg sm:leading-9"
              >
                Step inside Doremi Fusion — a music studio in Kolkata created
                for recording, production, rehearsal and musical expression.
              </p>

            </div>


            <a
              href="#gallery-grid"
              class="mt-9 inline-flex items-center gap-4 rounded-full border border-[#b45cff]/50 px-6 py-3 text-[10px] font-medium uppercase tracking-[0.22em] text-[#eee9f2] transition-all duration-300 hover:border-[#c875ff] hover:bg-[#b45cff]/[0.06]"
            >

              Explore the studio

              <span class="text-base text-[#c875ff]">
                ↓
              </span>

            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- ===================================================== -->
    <!-- INTRO -->
    <!-- ===================================================== -->

    <section
      class="border-b border-[#d8b4fe]/[0.12]"
    >

      <div
        class="mx-auto max-w-7xl px-6 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28"
      >

        <div
          class="grid gap-12 lg:grid-cols-12 lg:gap-20"
        >

          <div class="lg:col-span-5">

            <p
              class="text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
            >
              The Space
            </p>


            <h2
              class="mt-6 max-w-xl text-4xl font-medium leading-[1.02] tracking-[-0.045em] text-[#f7f3fa] sm:text-5xl lg:text-[4rem]"
            >
              See where

              <span class="block text-[#827b8b]">
                the music happens.
              </span>
            </h2>

          </div>


          <div
            class="lg:col-span-7 lg:pt-3"
          >

            <p
              class="max-w-2xl text-base leading-8 text-[#a8a1b0] sm:text-lg sm:leading-9"
            >
              From the recording environment to the instruments and equipment,
              every part of the studio contributes to the creative process.
            </p>


            <p
              class="mt-6 max-w-2xl text-sm leading-7 text-[#8f8797] sm:text-base sm:leading-8"
            >
              Click any photograph to view it in full.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- ===================================================== -->
    <!-- GALLERY COMPONENT -->
    <!-- ===================================================== -->

    <GalleryGrid images={galleryImages} />


    <!-- ===================================================== -->
    <!-- CREATIVE SPACE -->
    <!-- ===================================================== -->

    <section
      class="border-b border-[#d8b4fe]/[0.12]"
    >

      <div
        class="mx-auto max-w-7xl px-6 py-24 sm:px-8 sm:py-28 lg:px-12 lg:py-32"
      >

        <div
          class="grid gap-14 lg:grid-cols-12 lg:gap-20"
        >

          <div class="lg:col-span-5">

            <p
              class="text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
            >
              More Than A Room
            </p>


            <h2
              class="mt-6 max-w-xl text-4xl font-medium leading-[1.02] tracking-[-0.045em] text-[#f7f3fa] sm:text-5xl lg:text-[4.1rem]"
            >
              A place to

              <span class="block text-[#827b8b]">
                create together.
              </span>
            </h2>

          </div>


          <div
            class="lg:col-span-7 lg:pt-3"
          >

            <div
              class="max-w-2xl space-y-7 text-base leading-8 text-[#a8a1b0] sm:text-lg sm:leading-9"
            >

              <p>
                Music is rarely created in isolation. Recording, production,
                rehearsal and learning all become part of the process when
                musicians have a place to experiment and develop ideas.
              </p>


              <p>
                Doremi Fusion brings those different parts of the musical
                journey together in one creative environment in Kolkata.
              </p>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- ===================================================== -->
    <!-- CTA -->
    <!-- ===================================================== -->

    <section
      class="relative overflow-hidden"
    >

      <div
        class="pointer-events-none absolute left-1/2 top-1/2 h-[34rem] w-[34rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#b45cff]/[0.045] blur-[170px]"
      ></div>


      <div
        class="relative mx-auto max-w-7xl px-6 py-28 sm:px-8 sm:py-36 lg:px-12 lg:py-40"
      >

        <p
          class="text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
        >
          Come By
        </p>


        <div
          class="mt-7 grid gap-12 lg:grid-cols-12 lg:items-end"
        >

          <div class="lg:col-span-8">

            <h2
              class="max-w-5xl text-5xl font-medium leading-[0.95] tracking-[-0.05em] text-[#f7f3fa] sm:text-6xl lg:text-[6rem]"
            >
              Ready to make

              <span class="block text-[#827b8b]">
                something real<span class="text-[#c875ff]">?</span>
              </span>
            </h2>

          </div>


          <div
            class="lg:col-span-3 lg:col-start-10"
          >

            <p
              class="text-base leading-8 text-[#a8a1b0]"
            >
              Have a recording, production, class or rehearsal in mind?
              Start a conversation with Doremi Fusion.
            </p>


            <a
              href="/contact"
              class="group mt-8 inline-flex items-center gap-4 text-xs font-medium uppercase tracking-[0.2em] text-[#eee9f2]"
            >

              Contact us

              <span
                class="text-[#c875ff] transition-transform duration-300 group-hover:translate-x-1"
              >
                →
              </span>

            </a>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- ===================================================== -->
  <!-- LIGHTBOX COMPONENT -->
  <!-- ===================================================== -->

  <GalleryLightbox images={galleryImages} />


  <!-- ===================================================== -->
  <!-- STRUCTURED DATA -->
  <!-- ===================================================== -->

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "CollectionPage",
          "@id": "https://doremifusion.in/gallery#webpage",
          "url": "https://doremifusion.in/gallery",
          "name": "Doremi Fusion Gallery | Music Studio in Kolkata",
          "description": "Explore the Doremi Fusion music studio in Kolkata through photographs of the recording space, equipment, instruments and creative environment.",
          "isPartOf": {
            "@type": "WebSite",
            "name": "Doremi Fusion Music Studio",
            "url": "https://doremifusion.in"
          }
        },
        {
          "@type": "ImageGallery",
          "@id": "https://doremifusion.in/gallery#images",
          "name": "Doremi Fusion Music Studio Gallery",
          "description": "Photographs of the Doremi Fusion music studio, recording environment, equipment and instruments in Kolkata.",
          "url": "https://doremifusion.in/gallery"
        },
        {
          "@type": "BreadcrumbList",
          "@id": "https://doremifusion.in/gallery#breadcrumb",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": "https://doremifusion.in/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Gallery",
              "item": "https://doremifusion.in/gallery"
            }
          ]
        }
      ]
    }
  </script>

</Layout>