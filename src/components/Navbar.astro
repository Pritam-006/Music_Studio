---
const navItems = [
  {
    label: "About",
    href: "/#about",
  },
  {
    label: "Services",
    href: "/#services",
  },
  {
    label: "Gallery",
    href: "/#gallery",
  },
];
---

<header
  class="relative z-50 border-b border-white/[0.06] bg-[#030304]"
>
  <div
    class="mx-auto flex h-[72px] max-w-7xl items-center justify-between px-5 sm:px-8 lg:px-10"
  >
    <!-- Logo -->
    <a
      href="/"
      class="shrink-0 transition-opacity duration-300 hover:opacity-80"
      aria-label="Doremi Fusion home"
    >
      <img
        src="/images/branding/dlogo.png"
        alt="Doremi Fusion Music Studio"
        class="h-auto w-28 object-contain sm:w-32"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hidden items-center gap-9 md:flex"
      aria-label="Main navigation"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="group relative text-sm font-medium uppercase tracking-[0.14em] text-white/70 transition-colors duration-300 hover:text-white"
          >
            {item.label}

            <span
              class="absolute -bottom-2 left-0 h-px w-0 bg-gradient-to-r from-[#a855f7] to-[#d946ef] transition-all duration-300 group-hover:w-full"
            ></span>
          </a>
        ))
      }

      <!-- Desktop Contact -->
      <a
        href="/#contact"
        class="group relative rounded-full border border-[#a855f7]/70 px-6 py-3 text-sm font-medium uppercase tracking-[0.12em] text-white transition-all duration-300 hover:border-[#d946ef] hover:shadow-[0_0_25px_rgba(168,85,247,0.22)]"
      >
        <span
          class="absolute inset-0 -z-10 rounded-full bg-gradient-to-r from-[#a855f7]/10 to-[#d946ef]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
        ></span>

        Contact
      </a>
    </nav>

    <!-- Mobile Menu Button -->
      <button
        type="button"
        id="mobile-menu-button"
        class="group flex h-10 w-10 items-center justify-center text-white/80 transition-colors duration-300 hover:text-white md:hidden"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
      <svg
        id="menu-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16" />
        <path d="M4 12h16" />
        <path d="M4 17h16" />
      </svg>

      <svg
        id="close-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        class="hidden"
        aria-hidden="true"
      >
        <path d="M6 6l12 12" />
        <path d="M18 6L6 18" />
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation -->
  <div
    id="mobile-menu"
    class="absolute left-0 right-0 top-full hidden border-t border-white/[0.08] bg-[#050506]/95 backdrop-blur-xl md:hidden"
  >
    <nav
      class="mx-auto max-w-7xl px-5 py-7 sm:px-8"
      aria-label="Mobile navigation"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-link block border-b border-white/[0.07] py-5 text-base font-medium uppercase tracking-[0.14em] text-white/70 transition-colors duration-300 hover:text-white"
          >
            {item.label}
          </a>
        ))
      }

      <!-- Mobile Contact -->
      <a
        href="/contact"
        class="mobile-nav-link mt-6 inline-flex rounded-full border border-[#a855f7]/70 px-6 py-3 text-sm font-medium uppercase tracking-[0.12em] text-white transition-all duration-300 hover:border-[#d946ef]"
      >
        Contact
      </a>

      <!-- Mobile footer text -->
      <p
        class="mt-10 text-[10px] uppercase tracking-[0.28em] text-white/25"
      >
        Music Studio · Kolkata
      </p>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector(
    "#mobile-menu-button",
  ) as HTMLButtonElement | null;

  const mobileMenu = document.querySelector(
    "#mobile-menu",
  ) as HTMLElement | null;

  const menuIcon = document.querySelector(
    "#menu-icon",
  ) as SVGElement | null;

  const closeIcon = document.querySelector(
    "#close-icon",
  ) as SVGElement | null;

  const mobileLinks = document.querySelectorAll(
    ".mobile-nav-link",
  );

  if (menuButton && mobileMenu && menuIcon && closeIcon) {
    const setMenuState = (open: boolean) => {
      mobileMenu.classList.toggle("hidden", !open);

      menuIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);

      menuButton.setAttribute(
        "aria-expanded",
        String(open),
      );

      menuButton.setAttribute(
        "aria-label",
        open
          ? "Close navigation menu"
          : "Open navigation menu",
      );
    };

    menuButton.addEventListener("click", () => {
      const isOpen =
        menuButton.getAttribute("aria-expanded") === "true";

      setMenuState(!isOpen);
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        setMenuState(false);
      });
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768) {
        setMenuState(false);
      }
    });
  }
</script>