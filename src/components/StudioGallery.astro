            <div class="flex items-center gap-3">
              <span class="h-px w-7 bg-[#c084fc] sm:w-8"></span>

              <span
                class="text-[11px] font-medium uppercase tracking-[0.24em] text-white/88 sm:text-xs sm:tracking-[0.3em]"
              >
                The studio
              </span>
            </div>

            <span
              class="text-[11px] font-medium uppercase tracking-[0.2em] text-white/72 sm:text-xs"
