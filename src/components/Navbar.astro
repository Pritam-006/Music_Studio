---
const navItems = [
  {
    label: "About",
    href: "/about",
  },
  {
    label: "Services",
    href: "/services",
  },
  {
    label: "Gallery",
    href: "/gallery",
  },
  {
    label: "Contact",
    href: "/contact",
  },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class="navbar relative z-50 border-b border-white/[0.08] bg-[#0a0a0f]/88 backdrop-blur-xl"
>
  <div
    class="mx-auto flex h-[72px] max-w-7xl items-center justify-between px-5 sm:px-8 lg:px-10"
  >
    <!-- ========================================================= -->
    <!-- LOGO -->
    <!-- ========================================================= -->

    <a
      href="/"
      class="group relative shrink-0"
      aria-label="Doremi Fusion home"
    >
      <img
        src="/images/branding/dlogo.png"
        alt="Doremi Fusion Music Studio"
        class="h-auto w-28 object-contain transition-all duration-300 ease-out group-hover:scale-[1.02] group-hover:opacity-95 sm:w-32"
      />
    </a>


    <!-- ========================================================= -->
    <!-- DESKTOP NAVIGATION -->
    <!-- ========================================================= -->

    <nav
      class="hidden items-center gap-10 md:flex"
      aria-label="Main navigation"
    >
      {
        navItems.map((item) => {
          const itemPath = item.href.replace(/\/$/, "") || "/";
          const isActive =
            currentPath === itemPath ||
            (itemPath !== "/" && currentPath.startsWith(`${itemPath}/`));

          return (
            <a
              href={item.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "group relative py-2 text-sm font-medium uppercase tracking-[0.14em] transition-colors duration-300",
                isActive
                  ? "text-white"
                  : "text-white/65 hover:text-white",
              ]}
            >
              {item.label}

              <span
                class:list={[
                  "absolute bottom-0 left-0 h-px bg-gradient-to-r from-[#a855f7] to-[#d946ef] transition-all duration-300 ease-out",
                  isActive ? "w-full" : "w-0 group-hover:w-full",
                ]}
              ></span>
            </a>
          );
        })
      }
    </nav>


    <!-- ========================================================= -->
    <!-- MOBILE MENU BUTTON -->
    <!-- ========================================================= -->

    <button
      type="button"
      id="mobile-menu-button"
      class="relative flex h-10 w-10 items-center justify-center text-white/75 transition-colors duration-300 hover:text-white md:hidden"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <!-- ======================================================= -->
      <!-- HAMBURGER ICON -->
      <!-- ======================================================= -->

      <svg
        id="menu-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="21"
        height="21"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16"></path>
        <path d="M4 12h16"></path>
        <path d="M4 17h16"></path>
      </svg>


      <!-- ======================================================= -->
      <!-- CLOSE ICON -->
      <!-- ======================================================= -->

      <svg
        id="close-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="21"
        height="21"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
        hidden
      >
        <path d="M6 6l12 12"></path>
        <path d="M18 6L6 18"></path>
      </svg>
    </button>
  </div>


  <!-- ========================================================= -->
  <!-- MOBILE NAVIGATION -->
  <!-- ========================================================= -->

  <div
    id="mobile-menu"
    class="absolute left-0 right-0 top-full hidden overflow-hidden border-t border-white/[0.08] bg-[#0a0a0f]/[0.98] backdrop-blur-2xl md:hidden"
  >
    <nav
      class="mx-auto max-w-7xl px-5 py-7 sm:px-8"
      aria-label="Mobile navigation"
    >
      {
        navItems.map((item) => {
          const itemPath = item.href.replace(/\/$/, "") || "/";
          const isActive =
            currentPath === itemPath ||
            (itemPath !== "/" && currentPath.startsWith(`${itemPath}/`));

          return (
            <a
              href={item.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "mobile-nav-link group flex items-center justify-between border-b border-white/[0.08] py-5 text-base font-medium uppercase tracking-[0.14em] transition-colors duration-300",
                isActive
                  ? "text-white"
                  : "text-white/70 hover:text-white",
              ]}
            >
              <span>{item.label}</span>

              <span
                class:list={[
                  "text-sm text-[#d8b4fe] transition-all duration-300",
                  isActive
                    ? "translate-x-1 opacity-100"
                    : "opacity-0 group-hover:translate-x-1 group-hover:opacity-100",
                ]}
              >
                →
              </span>
            </a>
          );
        })
      }


      <!-- ======================================================= -->
      <!-- MOBILE FOOTER -->
      <!-- ======================================================= -->

      <div class="mt-9 flex items-center gap-3">
        <span class="h-px w-7 bg-[#a855f7]/60"></span>

        <p
          class="text-[10px] font-medium uppercase tracking-[0.24em] text-white/45"
        >
          Music Studio · Kolkata
        </p>
      </div>
    </nav>
  </div>
</header>


<!-- ========================================================= -->
<!-- MOBILE MENU SCRIPT -->
<!-- ========================================================= -->

<script>
  const menuButton = document.querySelector(
    "#mobile-menu-button",
  ) as HTMLButtonElement | null;

  const mobileMenu = document.querySelector(
    "#mobile-menu",
  ) as HTMLElement | null;

  const menuIcon = document.querySelector(
    "#menu-icon",
  ) as SVGElement | null;

  const closeIcon = document.querySelector(
    "#close-icon",
  ) as SVGElement | null;

  const mobileLinks = document.querySelectorAll(
    ".mobile-nav-link",
  );


  if (
    menuButton &&
    mobileMenu &&
    menuIcon &&
    closeIcon
  ) {

    /* =========================================================
       SET MENU STATE
    ========================================================= */

    const setMenuState = (open: boolean) => {

      /* -----------------------------------------
         Mobile menu
      ----------------------------------------- */

      mobileMenu.classList.toggle(
        "hidden",
        !open,
      );


      /* -----------------------------------------
         Icons

         IMPORTANT:
         Use native hidden property instead
         of relying only on Tailwind .hidden.
      ----------------------------------------- */

      menuIcon.hidden = open;
      closeIcon.hidden = !open;


      /* -----------------------------------------
         Accessibility
      ----------------------------------------- */

      menuButton.setAttribute(
        "aria-expanded",
        String(open),
      );

      menuButton.setAttribute(
        "aria-label",
        open
          ? "Close navigation menu"
          : "Open navigation menu",
      );


      /* -----------------------------------------
         Prevent background scrolling
         while mobile menu is open.
      ----------------------------------------- */

      if (window.innerWidth < 768) {
        document.body.style.overflow = open
          ? "hidden"
          : "";
      }
    };


    /* =========================================================
       INITIAL STATE
    ========================================================= */

    setMenuState(false);


    /* =========================================================
       TOGGLE MENU
    ========================================================= */

    menuButton.addEventListener(
      "click",
      () => {

        const isOpen =
          menuButton.getAttribute(
            "aria-expanded",
          ) === "true";

        setMenuState(!isOpen);
      },
    );


    /* =========================================================
       CLOSE AFTER CLICKING A LINK
    ========================================================= */

    mobileLinks.forEach((link) => {

      link.addEventListener(
        "click",
        () => {
          setMenuState(false);
        },
      );

    });


    /* =========================================================
       ESCAPE KEY
    ========================================================= */

    document.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key === "Escape" &&
          menuButton.getAttribute(
            "aria-expanded",
          ) === "true"
        ) {

          setMenuState(false);

          menuButton.focus();
        }

      },
    );


    /* =========================================================
       CLOSE WHEN RESIZING TO DESKTOP
    ========================================================= */

    window.addEventListener(
      "resize",
      () => {

        if (window.innerWidth >= 768) {
          setMenuState(false);
        }

      },
    );

  }
</script>


<!-- ========================================================= -->
<!-- NAVBAR STYLES -->
<!-- ========================================================= -->

<style>

  /*
    Native hidden attribute must always win.

    This prevents another global SVG rule from
    accidentally making the close icon visible.
  */

  #mobile-menu-button svg[hidden] {
    display: none !important;
  }


  /*
    Keep both icons perfectly centered.
  */

  #mobile-menu-button svg {
    display: block;
    flex-shrink: 0;
  }


  /*
    Prevent the button from changing size when
    switching between hamburger and close.
  */

  #mobile-menu-button {
    position: relative;
  }


  /*
    Small interaction feedback.
  */

  #mobile-menu-button:active {
    transform: scale(0.94);
  }


  /*
    Respect reduced-motion preference.
  */

  @media (prefers-reduced-motion: reduce) {

    #mobile-menu-button {
      transition: none;
    }

  }

</style>