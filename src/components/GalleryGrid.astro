---
interface GalleryImage {
  src: string;
  alt: string;
  category: string;
  number?: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<section
  id="gallery-grid"
  class="relative overflow-hidden bg-[#08070d] py-24 md:py-32"
>
  <div class="mx-auto max-w-7xl px-6 md:px-10">

    <!-- Section Header -->
    <div class="mb-14 max-w-3xl md:mb-20">
      <p
        class="gallery-reveal mb-5 text-[10px] font-medium uppercase tracking-[0.3em] text-purple-300"
      >
        Inside Doremi Fusion
      </p>

      <h2
        class="gallery-reveal text-4xl font-medium leading-[0.95] tracking-[-0.04em] text-white sm:text-5xl md:text-6xl lg:text-7xl"
      >
        A space built <span class="text-white/35">for sound.</span>
      </h2>

      <p
        class="gallery-reveal mt-7 max-w-2xl text-sm leading-7 text-white/50 md:text-base"
      >
        Explore the studio, recording environment, equipment and instruments
        that make Doremi Fusion a space for creating music in Kolkata.
      </p>
    </div>


    <!-- =========================
         FEATURE IMAGE
    ========================== -->
    {images[0] && (
      <div class="gallery-reveal mb-5">
        <button
          type="button"
          class="gallery-item group relative block h-[55vh] min-h-[380px] w-full overflow-hidden border border-white/[0.08] bg-[#0d0c12] text-left md:h-[650px]"
          data-gallery-index="0"
          aria-label={`View ${images[0].alt} in full screen`}
        >
          <img
            src={images[0].src}
            alt={images[0].alt}
            loading="eager"
            class="h-full w-full object-cover transition duration-1000 ease-out group-hover:scale-[1.03]"
          />

          <!-- Gradient -->
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"
          ></div>

          <!-- Hover Overlay -->
          <div
            class="pointer-events-none absolute inset-0 bg-purple-500/0 transition duration-700 group-hover:bg-purple-500/[0.08]"
          ></div>

          <!-- Content -->
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-10">
            <div class="flex items-end justify-between gap-6">

              <div>
                <p
                  class="mb-3 text-[10px] uppercase tracking-[0.28em] text-purple-300"
                >
                  {images[0].category}
                </p>

                <h3
                  class="max-w-xl text-xl font-medium tracking-[-0.02em] text-white md:text-3xl"
                >
                  {images[0].alt}
                </h3>
              </div>

              <span
                class="hidden h-12 w-12 shrink-0 items-center justify-center rounded-full border border-white/20 bg-black/20 text-lg text-white backdrop-blur-sm transition duration-500 group-hover:border-purple-300/60 group-hover:bg-purple-500/20 md:flex"
              >
                ↗
              </span>

            </div>
          </div>

          <!-- Number -->
          <span
            class="absolute right-6 top-6 text-[10px] tracking-[0.2em] text-white/50 md:right-10 md:top-10"
          >
            {images[0].number ?? "01"}
          </span>
        </button>
      </div>
    )}


    <!-- =========================
         TWO IMAGE ROW
    ========================== -->
    {images.length > 1 && (
      <div class="grid gap-5 md:grid-cols-2">

        {images.slice(1, 3).map((image, index) => {
          const actualIndex = index + 1;

          return (
            <div class="gallery-reveal">
              <button
                type="button"
                class="gallery-item group relative block h-[360px] w-full overflow-hidden border border-white/[0.08] bg-[#0d0c12] text-left md:h-[500px]"
                data-gallery-index={actualIndex}
                aria-label={`View ${image.alt} in full screen`}
              >
                <img
                  src={image.src}
                  alt={image.alt}
                  loading="lazy"
                  class="h-full w-full object-cover transition duration-1000 ease-out group-hover:scale-[1.04]"
                />

                <!-- Overlay -->
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent"
                ></div>

                <div
                  class="pointer-events-none absolute inset-0 bg-purple-500/0 transition duration-700 group-hover:bg-purple-500/[0.08]"
                ></div>

                <!-- Bottom Content -->
                <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
                  <div class="flex items-end justify-between gap-4">

                    <div>
                      <p
                        class="mb-2 text-[10px] uppercase tracking-[0.28em] text-purple-300"
                      >
                        {image.category}
                      </p>

                      <h3
                        class="max-w-md text-lg font-medium leading-snug text-white md:text-xl"
                      >
                        {image.alt}
                      </h3>
                    </div>

                    <span
                      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/20 bg-black/20 text-base text-white backdrop-blur-sm transition duration-500 group-hover:border-purple-300/60 group-hover:bg-purple-500/20"
                    >
                      ↗
                    </span>

                  </div>
                </div>

                <!-- Number -->
                <span
                  class="absolute right-6 top-6 text-[10px] tracking-[0.2em] text-white/50"
                >
                  {image.number ?? String(actualIndex + 1).padStart(2, "0")}
                </span>
              </button>
            </div>
          );
        })}

      </div>
    )}


    <!-- =========================
         THREE IMAGE ROW
    ========================== -->
    {images.length > 3 && (
      <div class="mt-5 grid gap-5 md:grid-cols-2">

        {images.slice(3, 5).map((image, index) => {
          const actualIndex = index + 3;

          return (
            <div class="gallery-reveal">
              <button
                type="button"
                class="gallery-item group relative block h-[320px] w-full overflow-hidden border border-white/[0.08] bg-[#0d0c12] text-left md:h-[420px]"
                data-gallery-index={actualIndex}
                aria-label={`View ${image.alt} in full screen`}
              >
                <img
                  src={image.src}
                  alt={image.alt}
                  loading="lazy"
                  class="h-full w-full object-cover transition duration-1000 ease-out group-hover:scale-[1.04]"
                />

                <!-- Overlay -->
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"
                ></div>

                <div
                  class="pointer-events-none absolute inset-0 bg-purple-500/0 transition duration-700 group-hover:bg-purple-500/[0.08]"
                ></div>

                <!-- Content -->
                <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
                  <div class="flex items-end justify-between gap-4">

                    <div>
                      <p
                        class="mb-2 text-[10px] uppercase tracking-[0.28em] text-purple-300"
                      >
                        {image.category}
                      </p>

                      <h3
                        class="max-w-md text-lg font-medium leading-snug text-white md:text-xl"
                      >
                        {image.alt}
                      </h3>
                    </div>

                    <span
                      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/20 bg-black/20 text-base text-white backdrop-blur-sm transition duration-500 group-hover:border-purple-300/60 group-hover:bg-purple-500/20"
                    >
                      ↗
                    </span>

                  </div>
                </div>

                <!-- Number -->
                <span
                  class="absolute right-6 top-6 text-[10px] tracking-[0.2em] text-white/50"
                >
                  {image.number ?? String(actualIndex + 1).padStart(2, "0")}
                </span>
              </button>
            </div>
          );
        })}

      </div>
    )}


    <!-- Bottom Note -->
    <div
      class="gallery-reveal mt-10 flex items-center gap-4 border-t border-white/[0.08] pt-6"
    >
      <span class="h-px w-8 bg-purple-400/60"></span>

      <p class="text-[10px] uppercase tracking-[0.25em] text-white/30">
        Click any image to view it in full
      </p>
    </div>

  </div>
</section>


<script>
  const revealItems = document.querySelectorAll(".gallery-reveal");

  if (revealItems.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("gallery-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
      }
    );

    revealItems.forEach((item) => {
      observer.observe(item);
    });
  }
</script>


<style>
  .gallery-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 700ms ease,
      transform 700ms ease;
  }

  .gallery-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .gallery-reveal:nth-child(2) {
    transition-delay: 80ms;
  }

  .gallery-reveal:nth-child(3) {
    transition-delay: 160ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .gallery-item img {
      transition: none;
    }
  }
</style>