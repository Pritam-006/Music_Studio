<section
  id="gallery"
  class="relative overflow-hidden bg-[#050506] py-20 sm:py-32 lg:py-44"
>
  <!-- Ambient light -->
  <div
    class="pointer-events-none absolute left-1/2 top-1/3 h-[30rem] w-[30rem] -translate-x-1/2 rounded-full bg-[#d946ef]/[0.025] blur-[160px]"
  ></div>

  <div class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">

    <!-- ========================================================= -->
    <!-- HEADING -->
    <!-- ========================================================= -->

    <div class="grid gap-8 sm:gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p
          class="mb-5 text-[10px] font-medium uppercase tracking-[0.38em] text-[#c084fc] sm:mb-6 sm:text-xs"
        >
          Inside Doremi Fusion
        </p>

        <h2
          class="max-w-5xl text-5xl font-semibold leading-[0.94] tracking-[-0.045em] text-white sm:text-6xl lg:text-[5.8rem]"
        >
          A space built
          <span class="block text-white/35">
            for sound<span class="text-[#d946ef]">.</span>
          </span>
        </h2>
      </div>

      <div class="lg:col-span-3 lg:col-start-10">
        <p
          class="max-w-md text-sm leading-7 text-white/50 sm:text-base sm:leading-8"
        >
          Step inside Doremi Fusion — a space designed for recording,
          production, rehearsal and musical expression.
        </p>
      </div>
    </div>


    <!-- ========================================================= -->
    <!-- MAIN IMAGE -->
    <!-- ========================================================= -->

    <div class="mt-14 sm:mt-20 lg:mt-28">
      <a
        href="/gallery"
        class="group relative block overflow-hidden"
      >
        <div
          class="relative aspect-[16/10] overflow-hidden sm:aspect-[16/8]"
        >
          <img
            src="/images/studio/p1.JPG"
            alt="Doremi Fusion music studio recording room in Kolkata"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-1000 ease-out group-hover:scale-[1.025]"
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/5 to-black/10"
          ></div>

          <div
            class="absolute bottom-4 left-4 right-4 flex items-end justify-between sm:bottom-8 sm:left-8 sm:right-8"
          >
            <div class="flex items-center gap-3">
              <span class="h-px w-7 bg-[#c084fc] sm:w-8"></span>

              <span
                class="text-[9px] uppercase tracking-[0.3em] text-white/65 sm:text-xs"
              >
                The studio
              </span>
            </div>

            <span
              class="text-[9px] uppercase tracking-[0.25em] text-white/50 sm:text-xs"
            >
              01
            </span>
          </div>
        </div>
      </a>
    </div>


    <!-- ========================================================= -->
    <!-- SECONDARY IMAGES -->
    <!-- ========================================================= -->

    <div class="mt-4 grid gap-4 md:mt-5 md:grid-cols-12 md:gap-5">

      <!-- Microphone -->
      <a
        href="/gallery"
        class="group relative block overflow-hidden md:col-span-5"
      >
        <div
          class="relative aspect-[4/5] overflow-hidden"
        >
          <img
            src="/images/studio/p3.JPG"
            alt="Microphone and recording equipment at Doremi Fusion"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-black/55 to-transparent"
          ></div>

          <div
            class="absolute bottom-4 left-4 right-4 flex justify-between sm:bottom-5 sm:left-5 sm:right-5"
          >
            <span
              class="text-[9px] uppercase tracking-[0.28em] text-white/60 sm:text-[10px]"
            >
              Recording
            </span>

            <span
              class="text-[9px] uppercase tracking-[0.2em] text-white/35 sm:text-[10px]"
            >
              02
            </span>
          </div>
        </div>
      </a>


      <!-- Console -->
      <a
        href="/gallery"
        class="group relative block overflow-hidden md:col-span-7"
      >
        <div
          class="relative aspect-[4/3] overflow-hidden sm:aspect-[7/5]"
        >
          <img
            src="/images/studio/p4.JPG"
            alt="Audio mixing equipment inside Doremi Fusion music studio"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-black/55 to-transparent"
          ></div>

          <div
            class="absolute bottom-4 left-4 right-4 flex justify-between sm:bottom-5 sm:left-5 sm:right-5"
          >
            <span
              class="text-[9px] uppercase tracking-[0.28em] text-white/60 sm:text-[10px]"
            >
              Production
            </span>

            <span
              class="text-[9px] uppercase tracking-[0.2em] text-white/35 sm:text-[10px]"
            >
              03
            </span>
          </div>
        </div>
      </a>

    </div>


    <!-- ========================================================= -->
    <!-- THIRD ROW -->
    <!-- ========================================================= -->

    <div class="mt-4 grid gap-4 md:mt-5 md:grid-cols-12 md:gap-5">

      <!-- Wide -->
      <a
        href="/gallery"
        class="group relative block overflow-hidden md:col-span-7"
      >
        <div
          class="relative aspect-[4/3] overflow-hidden sm:aspect-[7/5]"
        >
          <img
            src="/images/studio/p5.JPG"
            alt="Music equipment inside Doremi Fusion studio"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-black/55 to-transparent"
          ></div>

          <div
            class="absolute bottom-4 left-4 right-4 flex justify-between sm:bottom-5 sm:left-5 sm:right-5"
          >
            <span
              class="text-[9px] uppercase tracking-[0.28em] text-white/60 sm:text-[10px]"
            >
              Equipment
            </span>

            <span
              class="text-[9px] uppercase tracking-[0.2em] text-white/35 sm:text-[10px]"
            >
              04
            </span>
          </div>
        </div>
      </a>


      <!-- Small -->
      <a
        href="/gallery"
        class="group relative block overflow-hidden md:col-span-5"
      >
        <div
          class="relative aspect-[4/5] overflow-hidden"
        >
          <img
            src="/images/studio/p6.JPG"
            alt="Musical instruments at Doremi Fusion music studio"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-black/55 to-transparent"
          ></div>

          <div
            class="absolute bottom-4 left-4 right-4 flex justify-between sm:bottom-5 sm:left-5 sm:right-5"
          >
            <span
              class="text-[9px] uppercase tracking-[0.28em] text-white/60 sm:text-[10px]"
            >
              Instruments
            </span>

            <span
              class="text-[9px] uppercase tracking-[0.2em] text-white/35 sm:text-[10px]"
            >
              05
            </span>
          </div>
        </div>
      </a>

    </div>


    <!-- ========================================================= -->
    <!-- GALLERY CTA -->
    <!-- ========================================================= -->

    <div
      class="mt-10 flex flex-col gap-5 border-t border-white/[0.08] pt-7 sm:mt-16 sm:flex-row sm:items-center sm:justify-between sm:pt-8"
    >
      <p
        class="max-w-md text-xs leading-6 text-white/30 sm:text-sm"
      >
        Explore the rooms, instruments and details that make Doremi Fusion
        what it is.
      </p>

      <a
        href="/gallery"
        class="group inline-flex shrink-0 items-center gap-3 text-[10px] font-medium uppercase tracking-[0.2em] text-white/60 transition-colors duration-300 hover:text-white sm:gap-4 sm:text-xs"
      >
        View full gallery

        <span
          class="text-[#d946ef] transition-transform duration-300 group-hover:translate-x-1"
        >
          →
        </span>
      </a>
    </div>

  </div>
</section>