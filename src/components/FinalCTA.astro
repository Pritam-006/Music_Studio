<style>
  /* Standard content reveal */
  .cta-reveal {
    opacity: 0;
    transform: translateY(18px);

    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);

    will-change: opacity, transform;
  }

  /* Main heading gets a softer scale reveal */
  .cta-heading-reveal {
    opacity: 0;
    transform: translateY(18px) scale(0.99);

    transition:
      opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);

    will-change: opacity, transform;
  }

  /* Contact shortcuts */
  .cta-contact-reveal {
    opacity: 0;
    transform: translateY(20px);

    transition:
      opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);

    will-change: opacity, transform;
  }

  .cta-reveal.is-visible,
  .cta-heading-reveal.is-visible,
  .cta-contact-reveal.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .cta-delay-1 {
    transition-delay: 0.08s;
  }

  .cta-delay-2 {
    transition-delay: 0.16s;
  }

  .cta-delay-3 {
    transition-delay: 0.1s;
  }

  .cta-delay-4 {
    transition-delay: 0.16s;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-reveal,
    .cta-heading-reveal,
    .cta-contact-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>


<script>
  const ctaElements = document.querySelectorAll(
    ".cta-reveal, .cta-heading-reveal, .cta-contact-reveal",
  );

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    {
      threshold: 0.12,
      rootMargin: "0px 0px -30px 0px",
    },
  );

  ctaElements.forEach((element) => observer.observe(element));
</script>
