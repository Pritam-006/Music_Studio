<style>
  /* =========================================================
     REVEAL SYSTEM
  ========================================================= */

  .recording-reveal,
  .recording-image-reveal,
  .recording-item,
  .recording-card {
    opacity: 0;
  }


  .recording-reveal,
  .recording-item,
  .recording-card {
    transform: translateY(24px);

    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);

    will-change: opacity, transform;
  }


  .recording-image-reveal {
    transform: scale(0.975);

    transition:
      opacity 1s cubic-bezier(0.22, 1, 0.36, 1),
      transform 1s cubic-bezier(0.22, 1, 0.36, 1);

    will-change: opacity, transform;
  }


  .recording-reveal.is-visible,
  .recording-image-reveal.is-visible,
  .recording-item.is-visible,
  .recording-card.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }


  .recording-delay-1 {
    transition-delay: 0.1s;
  }


  .recording-delay-2 {
    transition-delay: 0.18s;
  }


  /* =========================================================
     SERVICE ROW HOVER
  ========================================================= */

  .recording-item:hover h3 {
    transform: translateX(4px);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }


  .recording-link:hover h3 {
    transform: translateX(5px);
  }


  .recording-link h3 {
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }


  /* =========================================================
     ACCESSIBILITY
  ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    .recording-reveal,
    .recording-image-reveal,
    .recording-item,
    .recording-card {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .recording-link h3,
    .recording-item h3 {
      transition: none;
    }
  }
</style>


<script>
  const recordingElements = document.querySelectorAll(
    ".recording-reveal, .recording-image-reveal, .recording-item, .recording-card",
  );

  const recordingObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          recordingObserver.unobserve(entry.target);
        }
      });
    },
    {
      threshold: 0.1,
      rootMargin: "0px 0px -30px 0px",
    },
  );


  recordingElements.forEach((element) => {
    recordingObserver.observe(element);
  });
</script>