---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const services = [
  "Recording",
  "Music Production",
  "Mixing & Mastering",
  "Music Classes",
  "Jam Pad",
  "Not sure yet",
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://doremifusion.in/contact#webpage",
      url: "https://doremifusion.in/contact",
      name: "Contact Doremi Fusion | Music Studio in Kolkata",
      description:
        "Get in touch with Doremi Fusion in Kolkata for recording, music production, mixing and mastering, music classes and jam sessions.",
    isPartOf: {
        "@id": "https://doremifusion.in#website",
      },
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://doremifusion.in#organization",
      name: "Doremi Fusion Music Studio",
      url: "https://doremifusion.in",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Kolkata",
        addressRegion: "West Bengal",
        addressCountry: "IN",
      },
      openingHours: "Mo-Su 10:00-23:00",
      areaServed: {
        "@type": "City",
        name: "Kolkata",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://doremifusion.in/contact#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://doremifusion.in/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Contact",
          item: "https://doremifusion.in/contact",
        },
      ],
    },
  ],
};
---

<Layout
  title="Contact Doremi Fusion | Music Studio in Kolkata"
  description="Get in touch with Doremi Fusion in Kolkata for recording, music production, mixing and mastering, music classes and jam sessions."
  canonical="/contact"
>

  <Navbar />

  <main class="overflow-hidden bg-[#07080d] text-[#f5f5f7]">

    <!-- ===================================================== -->
    <!-- HERO -->
    <!-- ===================================================== -->

    <section class="relative border-b border-white/[0.10]">

      <!-- Subtle ambient glow -->

      <div
        class="pointer-events-none absolute -left-64 top-20 h-[34rem] w-[34rem] rounded-full bg-purple-600/[0.045] blur-[170px]"
      ></div>

      <div
        class="pointer-events-none absolute -right-64 top-0 h-[32rem] w-[32rem] rounded-full bg-fuchsia-600/[0.025] blur-[170px]"
      ></div>


      <div
        class="relative mx-auto max-w-7xl px-6 pb-24 pt-28 sm:px-8 sm:pb-28 lg:px-12 lg:pb-32 lg:pt-32"
      >

        <!-- Breadcrumb -->

        <nav
          aria-label="Breadcrumb"
          class="mb-14"
        >

          <ol
            class="flex items-center gap-3 text-[10px] uppercase tracking-[0.25em] text-[#686a73] sm:text-xs"
          >

            <li>
              <a
                href="/"
                class="transition-colors duration-300 hover:text-[#f5f5f7]"
              >
                Home
              </a>
            </li>

            <li
              aria-hidden="true"
              class="text-[#c875ff]"
            >
              /
            </li>

            <li class="text-[#a0a1a8]">
              Contact
            </li>

          </ol>

        </nav>


        <!-- Hero -->

        <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">

          <!-- Left -->

          <div class="lg:col-span-8">

            <p
              class="mb-7 text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
            >
              Start A Conversation
            </p>


            <h1
              class="max-w-[950px] text-[3.8rem] font-medium leading-[0.9] tracking-[-0.055em] text-[#f5f5f7] sm:text-6xl md:text-7xl lg:text-[6.5rem]"
            >
              Let's talk

              <span class="block text-[#777983]">
                about the music<span class="text-[#c875ff]">.</span>
              </span>
            </h1>


            <!-- Editorial line -->

            <div class="mt-12 hidden items-center gap-7 sm:flex">

              <span class="h-px w-14 bg-white/35"></span>

              <div
                class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[9px] uppercase tracking-[0.34em] text-[#777983]"
              >

                <span>Ideas</span>

                <span class="text-white/20">|</span>

                <span>Projects</span>

                <span class="text-white/20">|</span>

                <span>Sessions</span>

                <span class="text-white/20">|</span>

                <span>Collaboration</span>

              </div>

            </div>

          </div>


          <!-- Right -->

          <div class="lg:col-span-4 lg:pt-12">

            <div
              class="border-l border-white/[0.22] pl-7 sm:pl-9"
            >

             <p
              class="max-w-md text-base leading-8 text-[#9698a1] sm:text-lg sm:leading-9"
            >
              Get in touch with Doremi Fusion, a music studio in Kolkata, for
              recording, music production, mixing, mastering, music classes
              and jam sessions.
            </p>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- ===================================================== -->
    <!-- CONTACT FORM -->
    <!-- ===================================================== -->

    <section class="border-b border-white/[0.10]">

      <div
        class="mx-auto max-w-7xl px-6 py-24 sm:px-8 sm:py-28 lg:px-12 lg:py-32"
      >

        <div class="grid gap-16 lg:grid-cols-12 lg:gap-20">

          <!-- Intro -->

          <div class="lg:col-span-4">

            <p
              class="text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
            >
              The Conversation
            </p>


            <h2
              class="mt-6 max-w-md text-4xl font-medium leading-[1.02] tracking-[-0.045em] text-[#f5f5f7] sm:text-5xl"
            >
              Tell us

              <span class="block text-[#777983]">
                what you're making.
              </span>
            </h2>


            <p
              class="mt-8 max-w-sm text-sm leading-7 text-[#7f818a] sm:text-base sm:leading-8"
            >
              Whether you already know what you need or you're still figuring
              it out, start with the idea.
            </p>

          </div>


          <!-- Form -->

          <div class="lg:col-span-7 lg:col-start-6">

            <form
              id="contact-form"
              class="space-y-10"
            >

              <!-- Name -->

              <div class="group relative">

                <label
                  for="name"
                  class="mb-3 block text-[10px] font-medium uppercase tracking-[0.25em] text-[#777983]"
                >
                  Your Name
                </label>

                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  placeholder="Enter your name"
                  class="w-full border-b border-white/[0.16] bg-transparent px-0 py-4 text-base text-[#f5f5f7] outline-none placeholder:text-[#4f5159] transition-colors duration-300 focus:border-[#c875ff] sm:text-lg"
                />

              </div>


              <!-- Email -->

              <div class="group relative">

                <label
                  for="email"
                  class="mb-3 block text-[10px] font-medium uppercase tracking-[0.25em] text-[#777983]"
                >
                  Email
                </label>

                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="Enter your email"
                  class="w-full border-b border-white/[0.16] bg-transparent px-0 py-4 text-base text-[#f5f5f7] outline-none placeholder:text-[#4f5159] transition-colors duration-300 focus:border-[#c875ff] sm:text-lg"
                />

              </div>


              <!-- Phone -->

              <div class="group relative">

                <label
                  for="phone"
                  class="mb-3 block text-[10px] font-medium uppercase tracking-[0.25em] text-[#777983]"
                >
                  Phone / WhatsApp
                </label>

                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  placeholder="Enter your phone number"
                  class="w-full border-b border-white/[0.16] bg-transparent px-0 py-4 text-base text-[#f5f5f7] outline-none placeholder:text-[#4f5159] transition-colors duration-300 focus:border-[#c875ff] sm:text-lg"
                />

              </div>


              <!-- Service -->

              <div class="group relative">

                <label
                  for="service"
                  class="mb-3 block text-[10px] font-medium uppercase tracking-[0.25em] text-[#777983]"
                >
                  What Do You Need?
                </label>

                <select
                  id="service"
                  name="service"
                  required
                  class="w-full appearance-none border-b border-white/[0.16] bg-[#07080d] px-0 py-4 text-base text-[#9698a1] outline-none transition-colors duration-300 focus:border-[#c875ff] sm:text-lg"
                >

                  <option value="" disabled selected>
                    Select a service
                  </option>

                  {
                    services.map((service) => (
                      <option value={service}>
                        {service}
                      </option>
                    ))
                  }

                </select>

              </div>


              <!-- Message -->

              <div class="group relative">

                <label
                  for="message"
                  class="mb-3 block text-[10px] font-medium uppercase tracking-[0.25em] text-[#777983]"
                >
                  Tell Us About Your Project
                </label>

                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  placeholder="Tell us a little about the song, project or session..."
                  class="w-full resize-none border-b border-white/[0.16] bg-transparent px-0 py-4 text-base leading-8 text-[#f5f5f7] outline-none placeholder:text-[#4f5159] transition-colors duration-300 focus:border-[#c875ff] sm:text-lg"
                ></textarea>

              </div>


              <!-- Submit -->

              <div class="pt-2">

                <button
                  type="submit"
                  class="group inline-flex items-center gap-5 rounded-full bg-[#f5f5f7] px-7 py-4 text-sm font-medium text-[#07080d] transition-all duration-300 hover:bg-[#e8c9f7]"
                >

                  Send Enquiry

                  <span
                    class="text-base transition-transform duration-300 group-hover:translate-x-1"
                  >
                    ↗
                  </span>

                </button>


                <p
                  id="form-status"
                  class="mt-5 hidden text-sm text-[#9698a1]"
                  aria-live="polite"
                ></p>

              </div>

            </form>

          </div>

        </div>

      </div>

    </section>


    <!-- ===================================================== -->
    <!-- VISIT THE STUDIO -->
    <!-- ===================================================== -->

    <section class="border-b border-white/[0.10]">

      <div
        class="mx-auto max-w-7xl px-6 py-24 sm:px-8 sm:py-28 lg:px-12 lg:py-32"
      >

        <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">

          <!-- Left -->

          <div class="lg:col-span-5">

            <p
              class="text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
            >
              Visit The Studio
            </p>


            <h2
              class="mt-6 max-w-xl text-4xl font-medium leading-[1.02] tracking-[-0.045em] text-[#f5f5f7] sm:text-5xl lg:text-[4.2rem]"
            >
              Come make

              <span class="block text-[#777983]">
                something real.
              </span>
            </h2>

          </div>


          <!-- Right -->

          <div class="lg:col-span-7">

            <div
              class="grid gap-10 sm:grid-cols-2"
            >

              <!-- Address -->

              <div class="border-t border-white/[0.10] pt-6">

                <p
                  class="text-[10px] uppercase tracking-[0.25em] text-[#666871]"
                >
                  Studio
                </p>


                <address
                  class="mt-6 not-italic text-base leading-8 text-[#9698a1] sm:text-lg"
                >
                  Madurdaha, Hussainpur
                  <br />
                  Kolkata, West Bengal
                  <br />
                  India
                </address>

              </div>


              <!-- Hours -->

              <div class="border-t border-white/[0.10] pt-6">

                <p
                  class="text-[10px] uppercase tracking-[0.25em] text-[#666871]"
                >
                  Studio Hours
                </p>


                <p
                  class="mt-6 text-base leading-8 text-[#9698a1] sm:text-lg"
                >
                  10:00 AM — 11:00 PM
                </p>


                <p
                  class="mt-3 text-sm leading-7 text-[#666871]"
                >
                  Contact us before visiting to discuss your session.
                </p>

              </div>

            </div>


            <!-- Map -->

            <a
              href="https://www.google.com/maps/place/Chandrahar+Apartment,+790,+Hussainpur+Main+Rd,+Madurdaha,+Hussainpur,+Kolkata,+West+Bengal+700107/data=!4m2!3m1!1s0x3a027303196fd33b:0xff41fb269a29e32b!18m1!1e1?utm_source=mstt_1&entry=gps&coh=192189&g_ep=CAESBzI2LjM0LjQYACCenQoqnwEsMTAwODMzOTg0LDk0MjY3NzI3LDk0MjkyMTk1LDk0Mjk5NTMyLDEwMDc5NjQ5OCwxMDA3OTc3NjEsMTAwNzk2NTM1LDk0MjgwNTc2LDk0MjA3Mzk0LDk0MjA3NTA2LDk0MjA4NTA2LDk0MjE4NjUzLDk0MjI5ODM5LDk0Mjc1MTY4LDk0Mjc5NjE5LDEwMDgyMDIzNywxMDA4MjI0OTRCAklO&skid=66aa8d7f-cb7c-4117-8240-c8c02d341040&g_st=aw"
              target="_blank"
              rel="noopener noreferrer"
              class="group mt-12 block border border-white/[0.12] bg-[#0b0c11] p-8 transition-colors duration-300 hover:border-[#9b55c9]/50 sm:p-10"
            >

              <div class="flex items-center justify-between gap-6">

                <div>

                  <p
                    class="text-[10px] uppercase tracking-[0.25em] text-[#666871]"
                  >
                    Location
                  </p>

                  <p
                    class="mt-4 text-lg font-medium text-[#f1f1f3]"
                  >
                    Madurdaha, Hussainpur
                  </p>

                  <p
                    class="mt-2 text-sm text-[#7f818a]"
                  >
                    Kolkata, West Bengal
                  </p>

                </div>


                <span
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/[0.14] text-[#c875ff] transition-all duration-300 group-hover:border-[#c875ff]/60 group-hover:translate-x-1"
                >
                  ↗
                </span>

              </div>

            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- ===================================================== -->
    <!-- CONNECT -->
    <!-- ===================================================== -->

    <section class="border-b border-white/[0.10]">

      <div
        class="mx-auto max-w-7xl px-6 py-24 sm:px-8 sm:py-28 lg:px-12 lg:py-32"
      >

        <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">

          <!-- Left -->

          <div class="lg:col-span-5">

            <p
              class="text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
            >
              Other Ways To Connect
            </p>


            <h2
              class="mt-6 max-w-xl text-4xl font-medium leading-[1.02] tracking-[-0.045em] text-[#f5f5f7] sm:text-5xl"
            >
              Stay <span class="text-[#777983]">
                connected.
              </span>
            </h2>

          </div>


          <!-- Social links -->

          <div
            class="lg:col-span-7"
          >

            <div
              class="divide-y divide-white/[0.10] border-y border-white/[0.10]"
            >

              <a
                href="https://www.instagram.com/doremifusion?igsi=ajM2enBteXZtYXd3"
                target="_blank"
                aria-label="Doremi Fusion on Instagram"
                rel="noopener noreferrer"
                class="group flex items-center justify-between py-7"
              >

                <span
                  class="text-xl font-medium tracking-[-0.02em] text-[#f1f1f3]"
                >
                  Instagram
                </span>

                <span
                  class="text-[#c875ff] transition-transform duration-300 group-hover:translate-x-1"
                >
                  ↗
                </span>

              </a>


              <a
                href="https://www.facebook.com/people/Doremi-Fusion-Music-Studio-and-Jampad/61559428367056/"
                target="_blank"
                aria-label="Doremi Fusion on Facebook"
                rel="noopener noreferrer"
                class="group flex items-center justify-between py-7"
              >

                <span
                  class="text-xl font-medium tracking-[-0.02em] text-[#f1f1f3]"
                >
                  Facebook
                </span>

                <span
                  class="text-[#c875ff] transition-transform duration-300 group-hover:translate-x-1"
                >
                  ↗
                </span>

              </a>


              <a
                href="https://wa.me/919014145236"
                target="_blank"
                aria-label="Contact Doremi Fusion on WhatsApp"
                rel="noopener noreferrer"
                class="group flex items-center justify-between py-7"
              >

                <span
                  class="text-xl font-medium tracking-[-0.02em] text-[#f1f1f3]"
                >
                  WhatsApp
                </span>

                <span
                  class="text-[#c875ff] transition-transform duration-300 group-hover:translate-x-1"
                >
                  ↗
                </span>

              </a>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- ===================================================== -->
    <!-- FINAL CTA -->
    <!-- ===================================================== -->

    <section class="relative overflow-hidden">

      <div
        class="pointer-events-none absolute left-1/2 top-1/2 h-[34rem] w-[34rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-purple-600/[0.045] blur-[170px]"
      ></div>


      <div
        class="relative mx-auto max-w-7xl px-6 py-28 sm:px-8 sm:py-36 lg:px-12 lg:py-40"
      >

        <p
          class="text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
        >
          Your Next Session
        </p>


        <h2
          class="mt-7 max-w-5xl text-5xl font-medium leading-[0.95] tracking-[-0.05em] text-[#f5f5f7] sm:text-6xl lg:text-[6rem]"
        >
          Have something

          <span class="block text-[#777983]">
            in mind?
          </span>
        </h2>


        <div class="mt-10 flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">

          <p
            class="max-w-xl text-base leading-8 text-[#9698a1] sm:text-lg"
          >
            Start with the idea. We'll figure out the rest together.
          </p>


          <a
            href="#contact-form"
            class="group inline-flex shrink-0 items-center gap-4 text-xs font-medium uppercase tracking-[0.2em] text-[#f1f1f3]"
          >

            Start a conversation

            <span
              class="text-base text-[#c875ff] transition-transform duration-300 group-hover:translate-x-1"
            >
              ↑
            </span>

          </a>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- ===================================================== -->
  <!-- STRUCTURED DATA -->
  <!-- ===================================================== -->

  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

</Layout>


<!-- ========================================================= -->
<!-- CONTACT FORM BEHAVIOUR -->
<!-- ========================================================= -->

<script>
  const form = document.querySelector("#contact-form");
  const status = document.querySelector("#form-status");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    if (!(form instanceof HTMLFormElement)) return;

    const formData = new FormData(form);

    const name = String(formData.get("name") || "").trim();
    const email = String(formData.get("email") || "").trim();
    const phone = String(formData.get("phone") || "").trim();
    const service = String(formData.get("service") || "").trim();
    const message = String(formData.get("message") || "").trim();

    const whatsappMessage = [
      "Hello Doremi Fusion,",
      "",
      `Name: ${name}`,
      `Email: ${email}`,
      phone ? `Phone / WhatsApp: ${phone}` : "",
      `Service: ${service}`,
      "",
      "Project details:",
      message,
    ]
      .filter(Boolean)
      .join("\n");

    const whatsappUrl =
      `https://wa.me/919014145236?text=${encodeURIComponent(whatsappMessage)}`;

    if (status) {
      status.textContent =
        "Opening WhatsApp so you can send your enquiry.";
      status.classList.remove("hidden");
    }

    window.open(whatsappUrl, "_blank", "noopener,noreferrer");
  });
</script>


<!-- ========================================================= -->
<!-- REDUCED MOTION -->
<!-- ========================================================= -->

<style>
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>