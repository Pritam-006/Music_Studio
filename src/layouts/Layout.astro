---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = "Doremi Fusion | Music Studio in Kolkata",
  description =
    "Doremi Fusion is a music studio in Kolkata offering professional recording, music production, mixing and mastering, music classes and jam sessions.",
  canonical,
  ogImage = "/images/studio/p2.webp",
  noindex = false,
} = Astro.props;

const siteUrl = "https://doremifusion.in";

const canonicalUrl = canonical
  ? new URL(canonical, siteUrl).toString()
  : siteUrl;

const ogImageUrl = new URL(ogImage, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <!-- ========================================================= -->
    <!-- BASIC DOCUMENT META -->
    <!-- ========================================================= -->

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />

    <meta
      name="theme-color"
      content="#08080a"
    />

    <title>{title}</title>

    <!-- Canonical URL -->
    <link
      rel="canonical"
      href={canonicalUrl}
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- ========================================================= -->
    <!-- FAVICON -->
    <!-- ========================================================= -->

    <link
      rel="icon"
      type="image/png"
      href="/images/branding/doremi-logo.png"
    />

    <link
      rel="apple-touch-icon"
      href="/images/branding/doremi-logo.png"
    />

    <!-- ========================================================= -->
    <!-- OPEN GRAPH -->
    <!-- Used when pages are shared on Facebook, WhatsApp, etc. -->
    <!-- ========================================================= -->

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content="Doremi Fusion"
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="og:locale"
      content="en_IN"
    />

    <meta
      property="og:image"
      content={ogImageUrl}
    />

    <meta
      property="og:image:alt"
      content="Doremi Fusion Music Studio in Kolkata"
    />

    <!-- ========================================================= -->
    <!-- WEBSITE STRUCTURED DATA -->
    <!-- Helps search engines understand the website/entity -->
    <!-- ========================================================= -->

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Doremi Fusion",
      "alternateName": "Doremi Fusion Music Studio",
      "url": `${siteUrl}/`
    })} />

    <!-- ========================================================= -->
    <!-- ORGANIZATION / SOCIAL PROFILES -->
    <!-- ========================================================= -->

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      "name": "Doremi Fusion",
      "url": `${siteUrl}/`,
      "logo": `${siteUrl}/images/branding/doremi-logo.png`,
      "sameAs": [
        "https://www.instagram.com/doremifusion/",
        "https://www.facebook.com/doremifusion/"
      ]
    })} />

    <!-- ========================================================= -->
    <!-- PAGE-SPECIFIC HEAD CONTENT -->
    <!-- ========================================================= -->

    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>