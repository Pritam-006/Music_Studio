---
const services = [
  {
    number: "01",
    title: "Recording",
    description:
      "Vocal recording, voiceovers, dubbing, instrumental tracking and live session recording in a professionally equipped studio.",
    href: "/services/recording",
    image: "/images/services/recording1.png",
    imageAlt: "Music production setup at Doremi Fusion Music Studio in Kolkata",
    imageLabel: "CAPTURE IDEAS",
    sideLabel: "RECORD YOUR STORY",
  },
  {
    number: "02",
    title: "Music Production",
    description:
      "Complete music arrangement and production, including film scores, web-series music, short films and jingles.",
    href: "/services/music-production",
    image: "/images/services/d1.JPG",
    imageAlt: "Music production setup at Doremi Fusion Music Studio",
    imageLabel: "PRODUCE · ARRANGE · CREATE",
    sideLabel: "IDEAS INTO MUSIC",
  },
  {
    number: "03",
    title: "Mixing & Mastering",
    description:
      "Professional mixing and mastering prepared for digital platforms including Spotify, Apple Music and YouTube.",
    href: "/services/mixing-mastering",
    image: "/images/services/mm.jpg",
    imageAlt: "Audio mixing console at Doremi Fusion Music Studio",
    imageLabel: "SHAPE YOUR SOUND",
    sideLabel: "POLISH FOR A BIGGER STAGE",
  },
  {
    number: "04",
    title: "Music Classes",
    description:
      "Learn guitar, ukulele, drums and bass guitar in a fun, studio-based environment with experienced instructors.",
    href: "/services/music-classes",
    image: "/images/services/p7.JPG",
    imageAlt: "Music class environment at Doremi Fusion Music Studio",
    imageLabel: "MUSIC FOR A BRIGHTER YOU",
    sideLabel: "LEARN · PRACTICE · IMPROVE",
  },
  {
    number: "05",
    title: "Jam Pad",
    description:
      "A fully equipped, soundproof rehearsal space for bands and artists, with a plug-and-play setup for rehearsals.",
    href: "/services/jam-pad",
    image: "/images/services/jam.jpg",
    imageAlt: "Jam Pad rehearsal space at Doremi Fusion Music Studio",
    imageLabel: "PLAY TOGETHER",
    sideLabel: "BANDS · IDEAS · FRIENDS",
  },
];
---

<section
  id="services"
  class="relative overflow-hidden bg-[#0d0d12] py-24 sm:py-32 lg:py-40"
>
  <!-- ========================================================= -->
  <!-- AMBIENT BACKGROUND -->
  <!-- ========================================================= -->

  <div
    class="pointer-events-none absolute -left-48 top-1/4 h-96 w-96 rounded-full bg-[#d946ef]/[0.045] blur-[150px]"
  ></div>

  <div
    class="pointer-events-none absolute right-[-120px] top-1/2 h-96 w-96 rounded-full bg-[#a855f7]/[0.035] blur-[150px]"
  ></div>

  <div
    class="pointer-events-none absolute bottom-0 left-1/3 h-72 w-72 rounded-full bg-[#d946ef]/[0.025] blur-[140px]"
  ></div>


  <div class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">

    <!-- ========================================================= -->
    <!-- SECTION INTRO -->
    <!-- ========================================================= -->

    <div
      class="service-reveal grid gap-10 lg:grid-cols-12 lg:items-end"
    >

      <!-- Heading -->

      <div class="lg:col-span-7">

        <p
          class="mb-5 text-[10px] font-medium uppercase tracking-[0.32em] text-[#d8b4fe] sm:mb-6 sm:text-xs sm:tracking-[0.38em]"
        >
          Our Services
        </p>

        <h2
          class="max-w-4xl text-[2.8rem] font-semibold leading-[0.94] tracking-[-0.05em] text-white sm:text-6xl lg:text-[5.8rem]"
        >
          Sound built

          <span class="block text-white/65">
            around your vision<span class="text-[#d946ef]">.</span>
          </span>
        </h2>

      </div>


      <!-- Intro text -->

      <div class="lg:col-span-4 lg:col-start-9">

        <div class="flex gap-5">

          <span
            class="hidden h-16 w-px shrink-0 bg-gradient-to-b from-[#d8b4fe] to-transparent sm:block"
          ></span>

          <p
            class="max-w-md text-[14px] leading-7 text-white/72 sm:text-base sm:leading-8"
          >
            From recording and music production to mixing, music classes and
            jam sessions, Doremi Fusion brings together the space, tools and
            experience musicians need to create in Kolkata.
          </p>

        </div>

      </div>

    </div>


    <!-- ========================================================= -->
    <!-- SERVICES -->
    <!-- ========================================================= -->

    <div class="mt-16 sm:mt-24 lg:mt-28">

      {
        services.map((service, index) => {
          const isEven = index % 2 === 1;

          return (
            <a
              href={service.href}
              class:list={[
                "service-reveal",
                "service-item",
                `service-delay-${index + 1}`,
                "group",
                "relative",
                "grid",
                "items-center",
                "gap-8",
                "border-t",
                "border-white/[0.11]",
                "py-10",
                "sm:gap-12",
                "sm:py-14",
                "lg:grid-cols-12",
                "lg:gap-10",
                "lg:py-16",
                isEven ? "lg:[&_.service-image-wrap]:order-2" : "",
                isEven ? "lg:[&_.service-content]:order-1" : "",
              ]}
            >

              <!-- ================================================= -->
              <!-- IMAGE -->
              <!-- ================================================= -->

              <div
                class:list={[
                  "service-image-wrap",
                  "relative",
                  "overflow-hidden",
                  "lg:col-span-6",
                  isEven ? "lg:col-start-7" : "lg:col-start-1",
                ]}
              >

                <!-- Decorative top line -->

                <span
                  class:list={[
                    "absolute",
                    "-top-px",
                    "z-10",
                    "h-px",
                    "w-1/2",
                    "bg-[#d8b4fe]/70",
                    "transition-all",
                    "duration-700",
                    "group-hover:w-[70%]",
                    isEven ? "right-0" : "left-0",
                  ]}
                ></span>


                <!-- Decorative side line -->

                <span
                  class:list={[
                    "absolute",
                    "z-10",
                    "h-1/2",
                    "w-px",
                    "bg-[#d8b4fe]/60",
                    "transition-all",
                    "duration-700",
                    "group-hover:h-[70%]",
                    isEven ? "right-0" : "left-0",
                    "top-0",
                  ]}
                ></span>


                <!-- Image -->

                <div
                  class="relative aspect-[4/3] overflow-hidden border border-white/[0.10] bg-[#111118]"
                >

                  <img
                    src={service.image}
                    alt={service.imageAlt}
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.045]"
                  />


                  <!-- Image overlay -->

                  <div
                    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#050506]/80 via-transparent to-[#050506]/10"
                  ></div>


                  <!-- Image label -->

                  <div
                    class="absolute bottom-5 left-5 right-5 flex items-end justify-between sm:bottom-6 sm:left-6 sm:right-6"
                  >

                    <span
                      class="text-[8px] font-medium uppercase tracking-[0.28em] text-white/90 sm:text-[9px] sm:tracking-[0.34em]"
                    >
                      {service.imageLabel}
                    </span>

                    <span
                      class="flex h-8 w-8 items-center justify-center rounded-full border border-white/30 text-sm text-white/80 transition-all duration-300 group-hover:border-[#d946ef] group-hover:bg-[#a855f7]/10 group-hover:text-white"
                    >
                      ↗
                    </span>

                  </div>

                </div>

              </div>


              <!-- ================================================= -->
              <!-- CONTENT -->
              <!-- ================================================= -->

              <div
                class:list={[
                  "service-content",
                  "relative",
                  "lg:col-span-5",
                  isEven ? "lg:col-start-1" : "lg:col-start-8",
                ]}
              >

                <!-- Number -->

                <div class="mb-5 flex items-center gap-4">

                  <span
                    class="text-[11px] font-medium tracking-[0.22em] text-[#d8b4fe] sm:text-xs"
                  >
                    {service.number}
                  </span>

                  <span
                    class="h-px w-10 bg-white/20 transition-all duration-500 group-hover:w-16 group-hover:bg-[#d946ef]/70"
                  ></span>

                </div>


                <!-- Title -->

                <h3
                  class="max-w-xl text-[2.1rem] font-medium leading-[1] tracking-[-0.04em] text-white transition-transform duration-500 ease-out group-hover:translate-x-1 sm:text-4xl lg:text-[3.2rem]"
                >
                  {service.title}
                </h3>


                <!-- Description -->

                <p
                  class="mt-5 max-w-lg text-[14px] leading-7 text-white/68 transition-colors duration-500 group-hover:text-white/85 sm:text-base sm:leading-8"
                >
                  {service.description}
                </p>


                <!-- Learn more -->

                <div class="mt-7">

                  <span
                    class="inline-flex items-center gap-3 text-[9px] font-medium uppercase tracking-[0.28em] text-[#d8b4fe] transition-colors duration-300 group-hover:text-[#e879f9] sm:text-[10px] sm:tracking-[0.32em]"
                  >
                    Learn More

                    <span
                      class="text-sm transition-transform duration-300 group-hover:translate-x-1"
                    >
                      →
                    </span>
                  </span>

                </div>


                <!-- Side label -->

                <div
                  class:list={[
                    "pointer-events-none",
                    "absolute",
                    "hidden",
                    "xl:block",
                    "top-1/2",
                    "w-28",
                    "-translate-y-1/2",
                    isEven ? "right-[-155px]" : "left-[-155px]",
                  ]}
                >

                  <span
                    class="block text-[8px] font-medium uppercase leading-[1.9] tracking-[0.28em] text-[#d8b4fe]/80"
                  >
                    {service.sideLabel}
                  </span>

                </div>

              </div>

            </a>
          );
        })
      }

    </div>


    <!-- ========================================================= -->
    <!-- BOTTOM STATEMENT -->
    <!-- ========================================================= -->

    <div
      class="service-reveal service-delay-6 mt-12 border-t border-white/[0.11] pt-7 sm:mt-16 sm:pt-8"
    >

      <div class="flex items-center gap-4">

        <span
          class="h-px w-8 bg-[#d946ef] sm:w-10"
        ></span>

        <p
          class="text-[8px] font-medium uppercase tracking-[0.28em] text-white/55 sm:text-[10px] sm:tracking-[0.34em]"
        >
          Create · Rehearse · Record · Grow
        </p>

      </div>

    </div>


    <!-- ========================================================= -->
    <!-- EXPLORE ALL SERVICES -->
    <!-- ========================================================= -->

    <div
      class="service-reveal service-delay-6 mt-10 flex justify-start sm:mt-12 sm:justify-end"
    >

      <a
        href="/services"
        class="group inline-flex items-center gap-4 text-[10px] font-medium uppercase tracking-[0.2em] text-white/75 transition-colors duration-300 hover:text-white sm:text-xs"
      >
        Explore all services

        <span
          class="text-[#e879f9] transition-transform duration-300 group-hover:translate-x-1"
        >
          →
        </span>

      </a>

    </div>

  </div>
</section>


<style>

  /* =========================================================
     REVEAL ANIMATION
  ========================================================= */

  .service-reveal {
    opacity: 0;
    transform: translateY(22px);

    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);

    will-change: opacity, transform;
  }


  .service-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }


  /* =========================================================
     DELAYS
  ========================================================= */

  .service-delay-1 {
    transition-delay: 0.04s;
  }

  .service-delay-2 {
    transition-delay: 0.10s;
  }

  .service-delay-3 {
    transition-delay: 0.16s;
  }

  .service-delay-4 {
    transition-delay: 0.22s;
  }

  .service-delay-5 {
    transition-delay: 0.28s;
  }

  .service-delay-6 {
    transition-delay: 0.16s;
  }


  /* =========================================================
     IMAGE HOVER
  ========================================================= */

  .service-image-wrap {
    transition:
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }


  .service-item:hover .service-image-wrap {
    transform: translateY(-3px);
  }


  /* =========================================================
     MOBILE
  ========================================================= */

  @media (max-width: 1023px) {

    .service-item {
      grid-template-columns: 1fr;
    }

    .service-content {
      order: 2;
    }

    .service-image-wrap {
      order: 1;
    }

  }


  /* =========================================================
     REDUCED MOTION
  ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    .service-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .service-item:hover .service-image-wrap {
      transform: none;
    }

  }

</style>


<script>
  const serviceElements =
    document.querySelectorAll(".service-reveal");

  const serviceObserver =
    new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {

          if (entry.isIntersecting) {

            entry.target.classList.add(
              "is-visible",
            );

            serviceObserver.unobserve(
              entry.target,
            );

          }

        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -40px 0px",
      },
    );

  serviceElements.forEach((element) => {
    serviceObserver.observe(element);
  });
</script>