---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const siteUrl = "https://doremifusion.in";

const title = "Music Classes in Kolkata | Doremi Fusion";

const description =
  "Learn guitar, ukulele, drums and bass guitar at Doremi Fusion Music Studio in Kolkata in a studio-based learning environment.";

const canonical = `${siteUrl}/services/music-classes`;

const instruments = [
  {
    number: "01",
    title: "Guitar",
    description:
      "Build your understanding of the guitar through practical learning in a focused studio environment.",
    image: "/images/instruments/guitar.png",
    caption: "ACOUSTIC & ELECTRIC",
  },
  {
    number: "02",
    title: "Ukulele",
    description:
      "Learn the ukulele in a creative and approachable environment while developing your musical foundation.",
    image: "/images/instruments/ukulele1.png",
    caption: "SMALL INSTRUMENT · BIG POSSIBILITIES",
  },
  {
    number: "03",
    title: "Drums",
    description:
      "Develop rhythm, coordination and confidence through practical drum learning in the studio.",
    image: "/images/instruments/drums.png",
    caption: "RHYTHM BUILDS MUSCLES",
  },
  {
    number: "04",
    title: "Bass Guitar",
    description:
      "Understand the role of bass in music while developing technique, rhythm and musical awareness.",
    image: "/images/instruments/bass-guitar.png",
    caption: "THE FOUNDATION OF THE SOUND",
  },
];

const process = [
  {
    number: "01",
    title: "Understand",
    description:
      "Start by understanding the instrument, your musical interests and the direction you want to develop.",
  },
  {
    number: "02",
    title: "Practice",
    description:
      "Build your skills through practical exercises, musical concepts and regular playing.",
  },
  {
    number: "03",
    title: "Develop",
    description:
      "Turn practice into musical confidence by applying what you learn through actual playing.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: {
        "@id": `${siteUrl}#website`,
      },
      mainEntity: {
        "@id": `${canonical}#service`,
      },
      breadcrumb: {
        "@id": `${canonical}#breadcrumb`,
      },
    },

    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: "Music Classes",
      serviceType: "Music Classes",
      description:
        "Music classes for guitar, ukulele, drums and bass guitar at Doremi Fusion Music Studio in Kolkata.",
      url: canonical,
     provider: {
        "@id": `${siteUrl}#organization`,
      },
      areaServed: {
        "@type": "City",
        name: "Kolkata",
      },
      category: "Music Education",
    },

    
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: siteUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Services",
          item: `${siteUrl}/services`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Music Classes",
          item: canonical,
        },
      ],
    },

    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Doremi Fusion Music Studio",
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical="/services/music-classes"
  ogImage="/images/studio/p6.webp"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <Navbar />

  <main class="overflow-hidden bg-[#07080d] text-[#f5f5f7]">

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section class="relative overflow-hidden border-b border-white/[0.10]">

      <div
        class="pointer-events-none absolute -right-56 top-10 h-[34rem] w-[34rem] rounded-full bg-[#a855f7]/[0.05] blur-[170px]"
      ></div>

      <div
        class="pointer-events-none absolute -left-56 bottom-0 h-[28rem] w-[28rem] rounded-full bg-[#d946ef]/[0.025] blur-[160px]"
      ></div>

      <div
        class="relative mx-auto max-w-7xl px-5 pb-24 pt-20 sm:px-8 sm:pb-32 sm:pt-28 lg:px-10 lg:pb-40 lg:pt-32"
      >

        <!-- Breadcrumb -->

        <nav
          aria-label="Breadcrumb"
          class="classes-reveal mb-14 sm:mb-20"
        >
          <ol
            class="flex flex-wrap items-center gap-3 text-[10px] font-medium uppercase tracking-[0.24em] text-white/42 sm:text-xs sm:tracking-[0.3em]"
          >
            <li>
              <a
                href="/"
                class="transition-colors duration-300 hover:text-white/80"
              >
                Home
              </a>
            </li>

            <li aria-hidden="true" class="text-[#c084fc]">
              /
            </li>

            <li>
              <a
                href="/services"
                class="transition-colors duration-300 hover:text-white/80"
              >
                Services
              </a>
            </li>

            <li aria-hidden="true" class="text-[#c084fc]">
              /
            </li>

            <li
              aria-current="page"
              class="text-white/70"
            >
              Music Classes
            </li>
          </ol>
        </nav>


        <!-- Hero -->

        <div class="grid gap-12 lg:grid-cols-12 lg:items-end">

          <div class="classes-reveal lg:col-span-8">

            <p
              class="mb-5 text-[10px] font-medium uppercase tracking-[0.3em] text-[#d8b4fe] sm:mb-7 sm:text-xs sm:tracking-[0.38em]"
            >
              Music Classes · Kolkata
            </p>

            <h1
              class="max-w-5xl text-[3.25rem] font-semibold leading-[0.9] tracking-[-0.05em] text-white sm:text-6xl lg:text-[6.5rem]"
            >
              Learn the

              <span class="block text-white/58">
                instrument<span class="text-[#d946ef]">.</span>
              </span>
            </h1>

          </div>


          <div
            class="classes-reveal classes-delay-1 lg:col-span-3 lg:col-start-10"
          >
            <p
              class="max-w-md text-[15px] leading-7 text-white/70 sm:text-base sm:leading-8"
            >
              Studio-based music classes for guitar, ukulele, drums and bass
              guitar in a focused learning environment.
            </p>
          </div>

        </div>


        <!-- Hero Image -->

        <div class="classes-image-reveal mt-16 sm:mt-20 lg:mt-28">

          <div class="group relative overflow-hidden bg-[#121218]">

            <div
              class="absolute inset-0 z-10 bg-gradient-to-t from-black/60 via-black/5 to-transparent"
            ></div>

            <img
              src="/images/studio/p6.webp"
              alt="Musical instruments at Doremi Fusion Music Studio in Kolkata"
              fetchpriority="high"
              decoding="async"
              class="aspect-[16/9] w-full object-cover transition-transform duration-1000 ease-out group-hover:scale-[1.02]"
            />

            <div
              class="absolute bottom-5 left-5 z-20 flex items-center gap-3 sm:bottom-7 sm:left-7"
            >
              <span
                class="h-px w-8 bg-[#c084fc]"
              ></span>

              <span
                class="text-[10px] font-medium uppercase tracking-[0.22em] text-white/78 sm:text-xs sm:tracking-[0.3em]"
              >
                Music Classes
              </span>
            </div>

          </div>

        </div>


        <!-- Meta -->

        <div
          class="classes-reveal classes-delay-2 mt-7 flex flex-col gap-4 border-t border-white/[0.1] pt-6 sm:flex-row sm:items-center sm:justify-between sm:pt-7"
        >
          <p
            class="text-[10px] font-medium uppercase tracking-[0.22em] text-white/42 sm:text-xs sm:tracking-[0.28em]"
          >
            Guitar · Ukulele · Drums · Bass Guitar
          </p>

          <p
            class="text-[10px] font-medium uppercase tracking-[0.22em] text-white/42 sm:text-xs sm:tracking-[0.28em]"
          >
            Doremi Fusion · Kolkata
          </p>
        </div>

      </div>
    </section>


    <!-- ========================================================= -->
    <!-- INTRO -->
    <!-- ========================================================= -->

    <section
      class="relative overflow-hidden bg-[#0d0d12] py-24 sm:py-32 lg:py-40"
    >

      <div
        class="pointer-events-none absolute -right-48 top-1/3 h-[30rem] w-[30rem] rounded-full bg-[#a855f7]/[0.035] blur-[160px]"
      ></div>

      <div
        class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-10"
      >

        <div class="grid gap-12 lg:grid-cols-12">

          <div class="classes-reveal lg:col-span-6">

            <p
              class="mb-5 text-[10px] font-medium uppercase tracking-[0.3em] text-[#d8b4fe] sm:text-xs sm:tracking-[0.38em]"
            >
              The learning process
            </p>

            <h2
              class="max-w-3xl text-[2.8rem] font-semibold leading-[0.94] tracking-[-0.045em] text-white sm:text-5xl lg:text-[5.2rem]"
            >
              Make music

              <span class="block text-white/58">
                part of the journey<span class="text-[#d946ef]">.</span>
              </span>
            </h2>

          </div>


          <div
            class="classes-reveal classes-delay-1 lg:col-span-4 lg:col-start-9 lg:pt-8"
          >

            <p
              class="text-[16px] leading-8 text-white/72 sm:text-lg sm:leading-9"
            >
              Learning an instrument is about more than understanding
              individual techniques. It is about developing musical awareness,
              practice and confidence through playing.
            </p>

            <p
              class="mt-6 text-[15px] leading-7 text-white/55 sm:text-base sm:leading-8"
            >
              At Doremi Fusion, music classes take place in a studio-based
              environment where students can focus on learning and developing
              their instrument.
            </p>

          </div>

        </div>

      </div>
    </section>


    <!-- ========================================================= -->
    <!-- WHAT WE TEACH -->
    <!-- ========================================================= -->

    <section
      class="relative overflow-hidden bg-[#101016] py-24 sm:py-32 lg:py-40"
    >
      <!-- Ambient glow -->

      <div
        class="pointer-events-none absolute -left-64 top-32 h-[35rem] w-[35rem] rounded-full bg-[#a855f7]/[0.025] blur-[180px]"
      ></div>

      <div
        class="pointer-events-none absolute -right-64 bottom-32 h-[35rem] w-[35rem] rounded-full bg-[#d946ef]/[0.02] blur-[180px]"
      ></div>

      <div class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">

        <!-- ===================================================== -->
        <!-- SECTION INTRO -->
        <!-- ===================================================== -->

        <div class="grid gap-10 lg:grid-cols-12 lg:items-end">

          <div class="classes-reveal lg:col-span-7">
            <p
              class="mb-5 text-[10px] font-medium uppercase tracking-[0.3em] text-[#d8b4fe] sm:text-xs sm:tracking-[0.38em]"
            >
              What we teach
            </p>

            <h2
              class="max-w-4xl text-[2.8rem] font-semibold leading-[0.94] tracking-[-0.045em] text-white sm:text-5xl lg:text-[5.3rem]"
            >
              Four instruments.

              <span class="block text-white/55">
                One musical
              </span>

              <span class="block text-white/55">
                direction<span class="text-[#d946ef]">.</span>
              </span>
            </h2>
          </div>

          <div
            class="classes-reveal classes-delay-1 lg:col-span-4 lg:col-start-9 lg:pb-2"
          >
            <p
              class="max-w-md text-[15px] leading-7 text-white/62 sm:text-base sm:leading-8"
            >
              Choose an instrument and develop your skills through practical
              learning in a focused studio environment.
            </p>
          </div>

        </div>

        <!-- ===================================================== -->
        <!-- INSTRUMENTS -->
        <!-- ===================================================== -->

        <div class="mt-20 sm:mt-28 lg:mt-36">

          {
            instruments.map((instrument, index) => {
              const isImageLeft = index % 2 === 0;

              return (
                <article
                  class={`instrument-row classes-reveal ${
                    index !== instruments.length - 1
                      ? "mb-24 sm:mb-32 lg:mb-40"
                      : ""
                  }`}
                >

                  {isImageLeft ? (
                    <>
                      <!-- IMAGE LEFT -->

                      <div class="instrument-image-wrap">
                        <div class="instrument-image-frame">
                          <span class="instrument-line instrument-line-top"></span>
                          <span class="instrument-line instrument-line-side"></span>

                          <div class="instrument-image-container">
                            <img
                              src={instrument.image}
                              alt={`${instrument.title} at Doremi Fusion Music Studio in Kolkata`}
                              loading="lazy"
                              decoding="async"
                              class="instrument-image"
                            />

                            <div
                              class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"
                            ></div>

                            <div
                              class="absolute bottom-5 left-5 z-20 sm:bottom-7 sm:left-7"
                            >
                              <p
                                class="max-w-[250px] text-[9px] font-medium uppercase tracking-[0.25em] text-white/85 sm:text-[10px] sm:tracking-[0.3em]"
                              >
                                {instrument.caption}
                              </p>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- TEXT RIGHT -->

                      <div class="instrument-content">
                        <div class="mb-7 flex items-center gap-4">
                          <span
                            class="text-[10px] font-medium tracking-[0.22em] text-[#d8b4fe]"
                          >
                            {instrument.number}
                          </span>

                          <span class="h-px w-16 bg-white/[0.18]"></span>
                        </div>

                        <h3
                          class="text-[2.4rem] font-medium leading-[0.95] tracking-[-0.04em] text-white sm:text-5xl lg:text-[3.5rem]"
                        >
                          {instrument.title}
                        </h3>

                        <p
                          class="mt-6 max-w-lg text-[15px] leading-7 text-white/60 sm:text-base sm:leading-8"
                        >
                          {instrument.description}
                        </p>

                        <a
                          href="/contact"
                          class="group mt-8 inline-flex items-center gap-4 text-[9px] font-medium uppercase tracking-[0.3em] text-[#d8b4fe] transition-colors duration-300 hover:text-white sm:text-[10px]"
                        >
                          <span>Learn more</span>
                          <span
                            class="text-sm text-[#c875ff] transition-transform duration-300 group-hover:translate-x-1"
                          >
                            →
                          </span>
                        </a>
                      </div>
                    </>
                  ) : (
                    <>
                      <!-- TEXT LEFT -->

                      <div class="instrument-content">
                        <div class="mb-7 flex items-center gap-4">
                          <span
                            class="text-[10px] font-medium tracking-[0.22em] text-[#d8b4fe]"
                          >
                            {instrument.number}
                          </span>

                          <span class="h-px w-16 bg-white/[0.18]"></span>
                        </div>

                        <h3
                          class="text-[2.4rem] font-medium leading-[0.95] tracking-[-0.04em] text-white sm:text-5xl lg:text-[3.5rem]"
                        >
                          {instrument.title}
                        </h3>

                        <p
                          class="mt-6 max-w-lg text-[15px] leading-7 text-white/60 sm:text-base sm:leading-8"
                        >
                          {instrument.description}
                        </p>

                        <a
                          href="/contact"
                          class="group mt-8 inline-flex items-center gap-4 text-[9px] font-medium uppercase tracking-[0.3em] text-[#d8b4fe] transition-colors duration-300 hover:text-white sm:text-[10px]"
                        >
                          <span>Learn more</span>
                          <span
                            class="text-sm text-[#c875ff] transition-transform duration-300 group-hover:translate-x-1"
                          >
                            →
                          </span>
                        </a>
                      </div>

                      <!-- IMAGE RIGHT -->

                      <div class="instrument-image-wrap">
                        <div class="instrument-image-frame instrument-image-frame-right">
                          <span class="instrument-line instrument-line-top instrument-line-right"></span>
                          <span class="instrument-line instrument-line-side instrument-line-side-right"></span>

                          <div class="instrument-image-container">
                            <img
                              src={instrument.image}
                              alt={`${instrument.title} at Doremi Fusion Music Studio in Kolkata`}
                              loading="lazy"
                              decoding="async"
                              class="instrument-image"
                            />

                            <div
                              class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"
                            ></div>

                            <div
                              class="absolute bottom-5 right-5 z-20 text-right sm:bottom-7 sm:right-7"
                            >
                              <p
                                class="max-w-[250px] text-[9px] font-medium uppercase tracking-[0.25em] text-white/85 sm:text-[10px] sm:tracking-[0.3em]"
                              >
                                {instrument.caption}
                              </p>
                            </div>
                          </div>
                        </div>
                      </div>
                    </>
                  )}

                </article>
              );
            })
          }

        </div>

        <!-- ===================================================== -->
        <!-- BOTTOM STATEMENT -->
        <!-- ===================================================== -->

        <div
          class="classes-reveal mt-8 border-t border-white/[0.1] pt-8 sm:mt-12 sm:pt-10"
        >
          <div class="flex items-center gap-5">
            <span class="h-px w-7 bg-[#c875ff] sm:w-10"></span>

            <p
              class="text-[9px] font-medium uppercase tracking-[0.25em] text-white/55 sm:text-[10px] sm:tracking-[0.32em]"
            >
              Real instruments. Real guidance. Real progress.
            </p>
          </div>
        </div>

      </div>
    </section>


    <!-- ========================================================= -->
    <!-- OUR APPROACH -->
    <!-- ========================================================= -->

    <section
      class="relative overflow-hidden bg-[#0a0a0e] py-24 sm:py-32 lg:py-40"
    >

      <div
        class="pointer-events-none absolute -left-52 top-1/3 h-[32rem] w-[32rem] rounded-full bg-[#d946ef]/[0.025] blur-[170px]"
      ></div>

      <div
        class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-10"
      >

        <div class="grid gap-12 lg:grid-cols-12 lg:items-center">

          <!-- Left -->

          <div class="classes-reveal lg:col-span-5">

            <p
              class="mb-5 text-[10px] font-medium uppercase tracking-[0.3em] text-[#d8b4fe] sm:text-xs sm:tracking-[0.38em]"
            >
              Our approach
            </p>

            <h2
              class="text-[2.6rem] font-semibold leading-[0.95] tracking-[-0.045em] text-white sm:text-4xl lg:text-[4.3rem]"
            >
              Learn through

              <span class="block text-white/58">
                playing<span class="text-[#d946ef]">.</span>
              </span>
            </h2>

          </div>


          <!-- Right -->

          <div class="classes-reveal classes-delay-1 lg:col-span-5 lg:col-start-8">

            <p
              class="text-[15px] leading-7 text-white/62 sm:text-base sm:leading-8"
            >
              Music becomes easier to understand when learning connects with
              actual playing. Developing an instrument means building technique
              while also understanding rhythm, musical ideas and expression.
            </p>

            <p
              class="mt-6 text-[15px] leading-7 text-white/52 sm:text-base sm:leading-8"
            >
              The aim is to create a learning environment where practice can
              gradually become confidence and musical ability.
            </p>

          </div>

        </div>

      </div>
    </section>


    <!-- ========================================================= -->
    <!-- PROCESS -->
    <!-- ========================================================= -->

    <section
      class="relative overflow-hidden border-b border-white/[0.10] bg-[#0d0d12] py-24 sm:py-32 lg:py-40"
    >

      <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">

        <div class="classes-reveal mb-16">

          <p
            class="text-[10px] font-medium uppercase tracking-[0.3em] text-[#d8b4fe] sm:text-xs sm:tracking-[0.38em]"
          >
            The process
          </p>

          <h2
            class="mt-6 max-w-4xl text-4xl font-semibold leading-[1.05] tracking-[-0.04em] text-white sm:text-5xl"
          >
            From first practice to
            <span class="text-white/58">
              musical confidence.
            </span>
          </h2>

        </div>


        <!-- Process cards -->

        <div
          class="grid overflow-hidden border border-white/[0.12] md:grid-cols-3"
        >

          {
            process.map((step, index) => (
              <article
                class={`classes-reveal bg-[#0b0c11] p-8 sm:p-9 lg:p-11 ${
                  index < process.length - 1
                    ? "border-b border-white/[0.10] md:border-b-0 md:border-r"
                    : ""
                }`}
              >

                <span
                  class="text-xs tracking-wider text-[#c875ff]"
                >
                  {step.number}
                </span>

                <h3
                  class="mt-16 text-xl font-medium tracking-[-0.025em] text-[#f1f1f3] sm:text-2xl"
                >
                  {step.title}
                </h3>

                <p
                  class="mt-4 text-sm leading-7 text-[#7f818a] sm:text-base sm:leading-8"
                >
                  {step.description}
                </p>

              </article>
            ))
          }

        </div>

      </div>
    </section>


    <!-- ========================================================= -->
    <!-- BUILT FOR -->
    <!-- ========================================================= -->

    <section
      class="border-b border-white/[0.10] bg-[#07080d] py-24 sm:py-28 lg:py-32"
    >

      <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">

        <div class="grid gap-16 lg:grid-cols-12 lg:gap-20">

          <div class="classes-reveal lg:col-span-5">

            <p
              class="text-xs font-medium uppercase tracking-[0.34em] text-[#c875ff]"
            >
              Built for
            </p>

            <h2
              class="mt-6 max-w-xl text-4xl font-medium leading-[1.05] tracking-[-0.04em] text-white sm:text-5xl"
            >
              A place to

              <span class="block text-[#777983]">
                keep learning.
              </span>
            </h2>

          </div>


          <div
            class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:col-span-7"
          >

            <div class="classes-reveal border-t border-white/[0.10] pt-5">

              <h3 class="font-medium text-[#f1f1f3]">
                Guitar Students
              </h3>

              <p class="mt-3 text-sm leading-7 text-[#7f818a]">
                Develop your guitar skills through practical learning and
                regular playing.
              </p>

            </div>


            <div class="classes-reveal border-t border-white/[0.10] pt-5">

              <h3 class="font-medium text-[#f1f1f3]">
                Ukulele Students
              </h3>

              <p class="mt-3 text-sm leading-7 text-[#7f818a]">
                Build familiarity with the ukulele while developing your
                musical foundation.
              </p>

            </div>


            <div class="classes-reveal border-t border-white/[0.10] pt-5">

              <h3 class="font-medium text-[#f1f1f3]">
                Drum Students
              </h3>

              <p class="mt-3 text-sm leading-7 text-[#7f818a]">
                Work on rhythm, coordination and confidence through practical
                drum learning.
              </p>

            </div>


            <div class="classes-reveal border-t border-white/[0.10] pt-5">

              <h3 class="font-medium text-[#f1f1f3]">
                Bass Guitar Students
              </h3>

