---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const siteUrl = "https://doremifusion.in";

const title =
  "About Doremi Fusion | Music Studio in Kolkata";

const description =
  "Learn about Doremi Fusion, a creative music studio in Kolkata built around recording, music production, mixing, mastering, musical learning and collaboration.";

const canonical = `${siteUrl}/about`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": `${canonical}#aboutpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: {
        "@id": `${siteUrl}#website`,
      },
      about: {
        "@id": `${siteUrl}#organization`,
      },
      breadcrumb: {
        "@id": `${canonical}#breadcrumb`,
      },
    },

    {
      "@type": "LocalBusiness",
      "@id": `${siteUrl}#organization`,
      name: "Doremi Fusion",
      url: siteUrl,
      description:
        "A creative music studio in Kolkata offering recording, music production, mixing, mastering, musical learning and rehearsal.",
      image: `${siteUrl}/images/studio/p2.webp`,
      logo: `${siteUrl}/images/branding/dlogo.png`,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Kolkata",
        addressRegion: "West Bengal",
        addressCountry: "IN",
      },
      areaServed: {
        "@type": "City",
        name: "Kolkata",
      },
      additionalType:
        "https://schema.org/ProfessionalService",
      knowsAbout: [
        "Music recording",
        "Music production",
        "Mixing and mastering",
        "Music education",
        "Band rehearsal",
      ],
    },

    {
      "@type": "Person",
      "@id": `${canonical}#rishiraj-basu`,
      name: "Rishiraj Basu",
      jobTitle: "Sound Engineer & Music Arranger",
      worksFor: {
        "@id": `${siteUrl}#organization`,
      },
    },

    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: siteUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "About",
          item: canonical,
        },
      ],
    },

    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Doremi Fusion Music Studio",
      publisher: {
        "@id": `${siteUrl}#organization`,
      },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical="/about"
  ogImage="/images/studio/p2.webp"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <Navbar />

  <main>

    <!-- ========================================================= -->
    <!-- ABOUT HERO -->
    <!-- ========================================================= -->

    <section
      class="relative overflow-hidden bg-[#09090f]"
    >
      <!-- Atmospheric glow -->

      <div
        class="pointer-events-none absolute -right-40 top-20 h-[30rem] w-[30rem] rounded-full bg-[#a855f7]/[0.045] blur-[160px]"
      ></div>

      <div
        class="pointer-events-none absolute -left-48 bottom-0 h-[26rem] w-[26rem] rounded-full bg-[#d946ef]/[0.025] blur-[150px]"
      ></div>

      <div
        class="relative mx-auto max-w-7xl px-5 pb-24 pt-20 sm:px-8 sm:pb-32 sm:pt-28 lg:px-10 lg:pb-40 lg:pt-32"
      >

        <!-- Breadcrumb -->

        <nav
          aria-label="Breadcrumb"
          class="about-reveal mb-14 sm:mb-20"
        >
          <ol
            class="flex items-center gap-3 text-[10px] font-medium uppercase tracking-[0.24em] text-white/42 sm:text-xs sm:tracking-[0.3em]"
          >
            <li>
              <a
                href="/"
                class="transition-colors duration-300 hover:text-white/80"
              >
                Home
              </a>
            </li>

            <li
              aria-hidden="true"
              class="text-[#c084fc]"
            >
              /
            </li>

            <li
              aria-current="page"
              class="text-white/70"
            >
              About
            </li>
          </ol>
        </nav>


        <!-- Hero content -->

        <div
          class="grid gap-12 lg:grid-cols-12 lg:items-end"
        >

          <div
            class="about-reveal lg:col-span-8"
          >
            <p
              class="mb-5 text-[10px] font-medium uppercase tracking-[0.3em] text-[#d8b4fe] sm:mb-7 sm:text-xs sm:tracking-[0.38em]"
            >
              About Doremi Fusion · Kolkata
            </p>

            <h1
              class="max-w-5xl text-[3.1rem] font-semibold leading-[0.92] tracking-[-0.05em] text-white sm:text-6xl lg:text-[6.3rem]"
            >
              A studio built

              <span class="block text-white/62">
                around the music<span class="text-[#d946ef]">.</span>
              </span>
            </h1>
          </div>


          <div
            class="about-reveal about-delay-1 lg:col-span-3 lg:col-start-10"
          >
            <p
              class="max-w-md text-[15px] leading-7 text-white/72 sm:text-base sm:leading-8"
            >
              Doremi Fusion is a creative music studio in Kolkata where
              artists, musicians and ideas come together to create,
              record and develop music.
            </p>
          </div>

        </div>


        <!-- Hero image -->

        <div
          class="about-image-reveal mt-16 sm:mt-20 lg:mt-28"
        >
          <div
            class="group relative overflow-hidden bg-[#121218]"
          >

            <div
              class="absolute inset-0 z-10 bg-gradient-to-t from-black/45 via-transparent to-transparent"
            ></div>

            <img
              src="/images/studio/p2.webp"
              alt="Inside Doremi Fusion Music Studio in Kolkata"
              fetchpriority="high"
              decoding="async"
              class="aspect-[16/8] w-full object-cover transition-transform duration-1000 ease-out group-hover:scale-[1.02]"
            />

            <div
              class="absolute bottom-5 left-5 z-20 flex items-center gap-3 sm:bottom-7 sm:left-7"
            >
              <span
                class="h-px w-8 bg-[#c084fc]"
              ></span>

              <span
                class="text-[10px] font-medium uppercase tracking-[0.22em] text-white/78 sm:text-xs sm:tracking-[0.3em]"
              >
                Inside Doremi Fusion
              </span>
            </div>

          </div>
        </div>


        <!-- Hero metadata -->

        <div
          class="about-reveal about-delay-2 mt-7 flex flex-col gap-4 border-t border-white/[0.1] pt-6 sm:flex-row sm:items-center sm:justify-between sm:pt-7"
        >
          <p
            class="text-[10px] font-medium uppercase tracking-[0.22em] text-white/45 sm:text-xs sm:tracking-[0.28em]"
          >
            Recording · Production · Learning
          </p>

          <p
            class="text-[10px] font-medium uppercase tracking-[0.22em] text-white/40 sm:text-xs sm:tracking-[0.28em]"
          >
            Kolkata, West Bengal
          </p>
        </div>

      </div>
    </section>


    <!-- ========================================================= -->
    <!-- OUR STORY -->
    <!-- ========================================================= -->

    <section
      class="relative overflow-hidden bg-[#0a0a0e] py-24 sm:py-32 lg:py-40"
    >

      <div
        class="pointer-events-none absolute -right-48 top-1/3 h-[30rem] w-[30rem] rounded-full bg-[#a855f7]/[0.035] blur-[160px]"
      ></div>

      <div
        class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-10"
      >

        <div
          class="grid gap-14 lg:grid-cols-12 lg:items-start lg:gap-0"
        >

          <!-- Heading -->

          <div
            class="about-reveal lg:col-span-4"
          >
            <p
              class="mb-5 text-[10px] font-medium uppercase tracking-[0.3em] text-[#d8b4fe] sm:text-xs sm:tracking-[0.38em]"
            >
              Our story
            </p>

            <h2
              class="max-w-md text-[2.8rem] font-semibold leading-[0.94] tracking-[-0.045em] text-white sm:text-5xl lg:text-[4.7rem]"
            >
              Built for

              <span class="block text-white/58">
                creative work<span class="text-[#d946ef]">.</span>
              </span>
            </h2>
          </div>


          <!-- Story -->

          <div
            class="about-reveal about-delay-1 lg:col-span-7 lg:col-start-6"
          >
            <div
              class="border-l border-white/[0.14] pl-6 sm:pl-10"
            >

              <p
                class="text-[19px] leading-8 text-white/88 sm:text-2xl sm:leading-10"
              >
                Doremi Fusion was created as a space where the technical
                side of music and the creative side of music can exist
                together.
              </p>

              <p
                class="mt-7 text-[15px] leading-7 text-white/64 sm:mt-8 sm:text-base sm:leading-8"
              >
                A song can begin with a simple idea — a melody, a lyric,
                a rhythm or a rough arrangement. Turning that idea into
                something finished takes more than equipment. It takes
                listening, experimentation, technical understanding and
                a space where the process can happen naturally.
              </p>

              <p
                class="mt-6 text-[15px] leading-7 text-white/64 sm:text-base sm:leading-8"
              >
                That is the role Doremi Fusion aims to play: a creative
                environment for recording, production, mixing, mastering,
                musical learning and rehearsal.
              </p>

              <p
                class="mt-6 text-[15px] leading-7 text-white/64 sm:text-base sm:leading-8"
              >
                Whether you are working on your first recording, shaping
                an arrangement, developing your sound or rehearsing with
                other musicians, the studio is designed around the work
                itself — the music.
              </p>

            </div>
          </div>

        </div>

      </div>
    </section>


    <!-- ========================================================= -->
    <!-- WHAT WE DO -->
    <!-- ========================================================= -->

    <section
      class="relative overflow-hidden bg-[#101016] py-24 sm:py-32 lg:py-40"
    >

      <div
        class="pointer-events-none absolute -left-52 top-1/4 h-[32rem] w-[32rem] rounded-full bg-[#d946ef]/[0.025] blur-[170px]"
      ></div>

      <div
        class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-10"
      >

        <!-- Heading -->

        <div
          class="grid gap-10 lg:grid-cols-12 lg:items-end"
        >

          <div
            class="about-reveal lg:col-span-7"
          >
            <p
              class="mb-5 text-[10px] font-medium uppercase tracking-[0.3em] text-[#d8b4fe] sm:text-xs sm:tracking-[0.38em]"
            >
              What happens here
            </p>

            <h2
              class="max-w-4xl text-[2.8rem] font-semibold leading-[0.94] tracking-[-0.045em] text-white sm:text-5xl lg:text-[5.4rem]"
            >
              More than

              <span class="block text-white/58">
                a recording room<span class="text-[#d946ef]">.</span>
              </span>
            </h2>
          </div>

          <div
            class="about-reveal about-delay-1 lg:col-span-4 lg:col-start-9"
          >
            <p
              class="max-w-md text-[15px] leading-7 text-white/68 sm:text-base sm:leading-8"
            >
              Different stages of the musical process come together under
              one roof, from the first idea to the finished work.
            </p>
          </div>

        </div>


        <!-- Services -->

        <div
          class="mt-16 border-t border-white/[0.1] sm:mt-24"
        >

          <!-- Recording -->

          <a
            href="/#services"
            class="about-service group grid gap-5 border-b border-white/[0.1] py-7 sm:grid-cols-12 sm:items-center sm:py-9"
          >
            <div
              class="sm:col-span-1"
            >
              <span
                class="text-[10px] font-medium tracking-[0.2em] text-[#d8b4fe]"
              >
                01
              </span>
            </div>

            <div
              class="sm:col-span-4"
            >
              <h3
                class="text-xl font-medium tracking-[-0.02em] text-white sm:text-2xl"
              >
                Recording
              </h3>
            </div>

            <div
              class="sm:col-span-6"
            >
              <p
                class="max-w-xl text-[14px] leading-6 text-white/55 sm:text-[15px] sm:leading-7"
              >
                A focused environment for capturing vocals, instruments
                and performances with attention to the details that make
                a recording feel alive.
              </p>
            </div>

            <div
              class="hidden justify-end sm:col-span-1 sm:flex"
            >
              <span
                class="text-lg text-[#e879f9] transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>
          </a>


          <!-- Music Production -->

          <a
            href="/#services"
            class="about-service group grid gap-5 border-b border-white/[0.1] py-7 sm:grid-cols-12 sm:items-center sm:py-9"
          >
            <div class="sm:col-span-1">
              <span
                class="text-[10px] font-medium tracking-[0.2em] text-[#d8b4fe]"
              >
                02
              </span>
            </div>

            <div class="sm:col-span-4">
              <h3
                class="text-xl font-medium tracking-[-0.02em] text-white sm:text-2xl"
              >
                Music Production
              </h3>
            </div>

            <div class="sm:col-span-6">
              <p
                class="max-w-xl text-[14px] leading-6 text-white/55 sm:text-[15px] sm:leading-7"
              >
                Developing arrangements, sounds and musical ideas into
                cohesive productions shaped around the character of the
                artist and the song.
              </p>
            </div>

            <div
              class="hidden justify-end sm:col-span-1 sm:flex"
            >
              <span
                class="text-lg text-[#e879f9] transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>
          </a>


          <!-- Mixing & Mastering -->

          <a
            href="/#services"
            class="about-service group grid gap-5 border-b border-white/[0.1] py-7 sm:grid-cols-12 sm:items-center sm:py-9"
          >
            <div class="sm:col-span-1">
              <span
                class="text-[10px] font-medium tracking-[0.2em] text-[#d8b4fe]"
              >
                03
              </span>
            </div>

            <div class="sm:col-span-4">
              <h3
                class="text-xl font-medium tracking-[-0.02em] text-white sm:text-2xl"
              >
                Mixing &amp; Mastering
              </h3>
            </div>

            <div class="sm:col-span-6">
              <p
                class="max-w-xl text-[14px] leading-6 text-white/55 sm:text-[15px] sm:leading-7"
              >
                Refining balance, space, dynamics and overall sonic
                character so the finished track translates with clarity
                and intention.
              </p>
            </div>

            <div
              class="hidden justify-end sm:col-span-1 sm:flex"
            >
              <span
                class="text-lg text-[#e879f9] transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>
          </a>


          <!-- Music Classes -->

          <a
            href="/#services"
            class="about-service group grid gap-5 border-b border-white/[0.1] py-7 sm:grid-cols-12 sm:items-center sm:py-9"
          >
            <div class="sm:col-span-1">
              <span
                class="text-[10px] font-medium tracking-[0.2em] text-[#d8b4fe]"
              >
                04
              </span>
            </div>

            <div class="sm:col-span-4">
              <h3
                class="text-xl font-medium tracking-[-0.02em] text-white sm:text-2xl"
              >
                Music Classes
              </h3>
            </div>

            <div class="sm:col-span-6">
              <p
                class="max-w-xl text-[14px] leading-6 text-white/55 sm:text-[15px] sm:leading-7"
              >
                A space for developing musical skills, understanding
                technique and building confidence through practical
                learning.
              </p>
            </div>

            <div
              class="hidden justify-end sm:col-span-1 sm:flex"
            >
              <span
                class="text-lg text-[#e879f9] transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>
          </a>


          <!-- Jam Pad -->

          <a
            href="/#services"
            class="about-service group grid gap-5 border-b border-white/[0.1] py-7 sm:grid-cols-12 sm:items-center sm:py-9"
          >
            <div class="sm:col-span-1">
              <span
                class="text-[10px] font-medium tracking-[0.2em] text-[#d8b4fe]"
              >
                05
              </span>
            </div>

            <div class="sm:col-span-4">
              <h3
                class="text-xl font-medium tracking-[-0.02em] text-white sm:text-2xl"
              >
                Jam Pad
              </h3>
            </div>

            <div class="sm:col-span-6">
              <p
                class="max-w-xl text-[14px] leading-6 text-white/55 sm:text-[15px] sm:leading-7"
              >
                A rehearsal space for musicians and bands to play
                together, experiment and develop ideas in a focused
                environment.
              </p>
            </div>

            <div
              class="hidden justify-end sm:col-span-1 sm:flex"
            >
              <span
                class="text-lg text-[#e879f9] transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>
          </a>

        </div>

      </div>
    </section>


    <!-- ========================================================= -->
    <!-- RISHIRAJ -->
    <!-- ========================================================= -->

    <section
      class="relative overflow-hidden bg-[#0b0b11] py-24 sm:py-32 lg:py-40"
    >

      <div
        class="pointer-events-none absolute -right-52 top-1/4 h-[34rem] w-[34rem] rounded-full bg-[#a855f7]/[0.045] blur-[170px]"
      ></div>

      <div
        class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-10"
      >

        <div
          class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-0"
        >

          <!-- Image -->

          <div
            class="about-image-reveal lg:col-span-7"
          >
            <div
              class="group relative overflow-hidden bg-[#15151c]"
            >

              <div
                class="absolute inset-0 z-10 bg-gradient-to-t from-black/45 via-black/5 to-transparent"
              ></div>

              <img
                src="/images/studio/d2.webp"
                alt="Rishiraj Basu working as a sound engineer at Doremi Fusion Music Studio in Kolkata"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.025]"
              />

              <div
                class="absolute bottom-5 left-5 z-20 flex items-center gap-3 sm:bottom-7 sm:left-7"
              >
                <span
                  class="h-px w-8 bg-[#c084fc]"
                ></span>

                <span
                  class="text-[10px] font-medium uppercase tracking-[0.2em] text-white/78 sm:text-xs sm:tracking-[0.28em]"
                >
                  The sound behind the studio
                </span>
              </div>

            </div>
          </div>


          <!-- Profile -->

          <div
            class="about-reveal about-delay-1 lg:col-span-4 lg:col-start-9"
          >
            <div
              class="border-l border-white/[0.14] pl-6 sm:pl-10"
            >

              <p
                class="text-[10px] font-medium uppercase tracking-[0.28em] text-[#d8b4fe] sm:text-xs sm:tracking-[0.34em]"
              >
                The person behind the sound
              </p>

              <h2
                class="mt-4 text-[2.2rem] font-medium leading-[0.98] tracking-[-0.035em] text-white sm:text-4xl"
              >
                Rishiraj Basu
              </h2>

              <p
                class="mt-2 text-sm font-medium uppercase tracking-[0.16em] text-white/52"
              >
                Sound Engineer &amp; Music Arranger
              </p>

              <p
                class="mt-7 text-[15px] leading-7 text-white/66 sm:mt-8 sm:text-base sm:leading-8"
              >
                At the heart of Doremi Fusion is a hands-on approach to
                sound — combining technical precision with musical
                understanding throughout the creative process.
              </p>

              <p
                class="mt-6 text-[15px] leading-7 text-white/66 sm:text-base sm:leading-8"
              >
                From recording and arrangement to production and the
                finishing stages of a track, the focus remains on
                helping the music communicate clearly and authentically.
              </p>

              <a
                href="/#gallery"
                class="group mt-9 inline-flex items-center gap-3 text-xs font-medium uppercase tracking-[0.16em] text-white/82"
              >
                Explore the studio

                <span
                  class="text-[#e879f9] transition-transform duration-300 group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  →
                </span>
              </a>

            </div>
          </div>

        </div>

      </div>
    </section>


    <!-- ========================================================= -->
    <!-- PHILOSOPHY -->
    <!-- ========================================================= -->

    <section
      class="relative overflow-hidden bg-[#101016] py-24 sm:py-32 lg:py-44"
    >

      <div
        class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-10"
      >

        <div
          class="about-reveal grid gap-12 lg:grid-cols-12"
        >

          <div
            class="lg:col-span-7"
          >
            <p
              class="mb-5 text-[10px] font-medium uppercase tracking-[0.3em] text-[#d8b4fe] sm:text-xs sm:tracking-[0.38em]"
            >
              Our philosophy
            </p>

            <h2
              class="max-w-4xl text-[2.8rem] font-semibold leading-[0.94] tracking-[-0.045em] text-white sm:text-5xl lg:text-[5.5rem]"
            >
              Technical skill.

              <span class="block text-white/58">
                Creative instinct<span class="text-[#d946ef]">.</span>
              </span>
            </h2>
          </div>


          <div
            class="lg:col-span-4 lg:col-start-9 lg:pt-8"
          >
            <p
              class="text-[16px] leading-8 text-white/70 sm:text-lg sm:leading-9"
            >
              Good sound is not only about equipment or technique. It is
              about understanding what the music is trying to say and
              making technical decisions that support that idea.
            </p>

            <p
              class="mt-6 text-[15px] leading-7 text-white/55 sm:text-base sm:leading-8"
            >
              That balance between craft and creativity shapes the way
              we approach every project at Doremi Fusion.
            </p>
          </div>

        </div>


        <!-- Principles -->

        <div
          class="mt-20 grid gap-px border border-white/[0.1] bg-white/[0.1] sm:grid-cols-3 lg:mt-28"
        >

          <div
            class="about-card bg-[#101016] p-7 sm:p-9 lg:p-10"
          >
            <span
              class="text-[10px] font-medium uppercase tracking-[0.24em] text-[#d8b4fe]"
            >
              01
            </span>

            <h3
              class="mt-8 text-xl font-medium tracking-[-0.02em] text-white"
            >
              Listen first.
            </h3>

            <p
              class="mt-4 text-sm leading-7 text-white/52"
            >
              Every project starts by understanding the music, the artist
              and the direction behind the work.
            </p>
          </div>


          <div
            class="about-card bg-[#101016] p-7 sm:p-9 lg:p-10"
